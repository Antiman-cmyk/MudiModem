FotaClearPackage()
{
    G_PACKAGENAME=`fotainfo --get-package |grep package| sed 's/.*:\(.*\)/\1/g'`
    G_PACKAGE="${G_PACKAGEPATH}/${G_PACKAGENAME}"
    if [ -f ${G_PACKAGE} ]; then
        rm -fr ${G_PACKAGE}
        sync
        fotainfo --set-package ""
        sync
    fi
}

FotaClearAll()
{
    FotaClearPackage
    FotaClearCache
    FotaClearLog
