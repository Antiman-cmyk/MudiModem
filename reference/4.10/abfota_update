SendBarToServer()
{
    local acc="${1}"
    FOTABAR=$((acc+FOTABAR))
    if [ ${FOTABAR} -le '99' ];then
        fotainfo --send-urc "+QABFOTA: \"UPDATE\",${FOTABAR}"
    fi
}

SendEndToServer()
{
    fotainfo --send-urc "+QABFOTA: \"UPDATE\",100"
}

FotaServerExit()
{
    fotasend -p "/usr/bin/abfota_update" --type ${MSG_TYPE_CTL} ${FOTA_PROCESS_EXIT}
