G_PACKAGENAME=`fotainfo --get-package |grep package| sed 's/.*:\(.*\)/\1/g'`
G_UPDATE_STAGE=`fotainfo --get-stage |grep stage| sed 's/.*:\(.*\)/\1/g'`

overlay_rootfs=false
grep -rn "ql_overlay_rootfs=1" /proc/cmdline > /dev/null
if [ $? -eq 0 ];then
    overlay_rootfs=true
fi


if [ $2 = '-k' ]
then
    KEEPCFGUPDATE="true"
    mkdir -p /etc/ab_keep_cfg
else
    [ ${G_CURRENT_STAT} != "UPDATE" ] && [ -e /etc/ab_keep_cfg ] && rm -rf /etc/ab_keep_cfg
fi

[ $2 = '-T' ] && {
    fwtool -q -i /tmp/sysupgrade.meta "${G_PACKAGEPATH}/${G_PACKAGENAME}"
    ValidateFotaPackage "${G_PACKAGEPATH}/${G_PACKAGENAME}"
    if [ ${G_PACKAGE_CHECK_FLAG} -eq 1 ];then
        exit 0
    else
        exit $?
    fi
}

# Register_Signal 15 Signal_SIGTERM_Hander
umask 0022
main
