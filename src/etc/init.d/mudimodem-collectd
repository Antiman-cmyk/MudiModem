#!/bin/sh /etc/rc.common
# procd service for MudiModem's collector: RF + battery history in /tmp/mudimodem, the eMMC
# backup, and the live pushes. Respawned on crash.
#
# Engine: mudimodemd on GL's own lua-eco (/usr/bin/eco, in the 4.10 image) — no Python, so live
# data works straight after a firmware upgrade, before the deps healer has reinstalled python3.
# The Python collector stays as the fallback (no eco) and the escape hatch: put the word
# `python` in /etc/mudimodem/collector to pin it. Both write the same files and pushes
# (test/collectd-emu.test.py runs them side by side on an emulated GL bus).

START=95
STOP=10
USE_PROCD=1
DAEMON=/usr/sbin/mudimodemd
PROG=/usr/sbin/mudimodem-collectd
DEPS=/usr/lib/mudimodem/mudimodem-deps
ENGINE_FILE=/etc/mudimodem/collector

engine() {
	if [ "$(cat "$ENGINE_FILE" 2>/dev/null)" != python ] && [ -x /usr/bin/eco ] && [ -f "$DAEMON" ]; then
		echo eco
	else
		echo python
	fi
}

start_service() {
	if [ "$(engine)" = eco ]; then
		procd_open_instance
		procd_set_param command /usr/bin/eco "$DAEMON"
		procd_set_param respawn
		procd_set_param stderr 1
		procd_close_instance
		return 0
	fi
	# No python3 (a firmware upgrade wipes opkg packages): let the healer
	# install it and start us, instead of respawning into "not found".
	if ! "$DEPS" check; then
		/usr/lib/mudimodem/mudimodem-detach "$DEPS" heal &
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/bin/python3 "$PROG"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
