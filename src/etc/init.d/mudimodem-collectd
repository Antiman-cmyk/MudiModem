#!/bin/sh /etc/rc.common
# procd service for mudimodemd, MudiModem's daemon on GL's own lua-eco (/usr/bin/eco, in the
# 4.10 image): the collector (RF + battery history in /tmp/mudimodem, the eMMC backup, the live
# pushes), the AT console's queue, the jobs (scan, speed test + its schedule, library, version
# check) and the confirm-or-revert arming. No Python. Respawned on crash.
# (The service keeps its 2.x name, which the page's hints and users' habits refer to.)

START=95
STOP=10
USE_PROCD=1
DAEMON=/usr/sbin/mudimodemd

start_service() {
	procd_open_instance mudimodemd
	procd_set_param command /usr/bin/eco "$DAEMON"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
