#!/bin/sh
# mudimodem-install — the ONE implementation of installing and removing MudiModem on a GL-E5800.
# install.sh (curl | sh), tools/deploy.sh (ssh), the self-updater and uninstall.sh all end here;
# what ships where comes from manifest.txt and nowhere else.
#
#   mudimodem-install preflight [model]          refuse anything that is not an E5800 on GL >= 4.10
#   mudimodem-install install --from <dir> [--base <url>]
#                                                 <dir> holds manifest.txt, version.json and every
#                                                 manifest source at its repo path (a "payload")
#   mudimodem-install uninstall [--from <dir>]    manifest: <dir>'s, else the installed copy
#   mudimodem-install keepd --from <dir>          print the firmware-upgrade keep list
#   mudimodem-install sources --from <dir>        print every source path the manifest needs
#
# MUDIMODEM_ROOT=<dir>: act on that directory as if it were / and RECORD every service or system
# command in <dir>/.mm-actions instead of running it (file placement is recorded too). The
# emulation tests use this; on the router it is unset. The one exception is the pending-revert
# step of uninstall, which runs <root>/usr/sbin/mudimodem-revert for real (tests put a fake there).
#
# POSIX sh; runs under the router's busybox ash (no pkill, no setsid, no `install`).
set -eu

ROOT="${MUDIMODEM_ROOT:-}"
ACTIONS="$ROOT/.mm-actions"
FROM=""
BASE="${MUDIMODEM_BASE:-}"

say()  { echo "$*"; }
die()  { echo "mudimodem-install: $*" >&2; exit 1; }
log()  { [ -n "$ROOT" ] && echo "$*" >> "$ACTIONS"; return 0; }

# A service action (procd init script). Recorded under MUDIMODEM_ROOT, run (never fatal) otherwise.
svc() {
  if [ -n "$ROOT" ]; then log "svc $1 $2"; return 0; fi
  [ -x "/etc/init.d/$1" ] || return 0
  "/etc/init.d/$1" "$2" >/dev/null 2>&1 || true
}
# Any other system command: $1 = a label for the record, the rest is the command.
sys() {
  label=$1; shift
  if [ -n "$ROOT" ]; then log "sys $label"; return 0; fi
  "$@" >/dev/null 2>&1 || true
}

# ---- argument parsing -------------------------------------------------------------------------
parse() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) FROM=${2:-}; shift 2 ;;
      --base) BASE=${2:-}; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
}

# ---- preflight ----------------------------------------------------------------------------------
# Model guard: on some LANs 192.168.8.1 is a DIFFERENT GL router. GL's own code keys on
# /proc/gl-hw-info/model. Firmware floor: 4.10 (numeric major.minor; a non-numeric part fails
# closed — dash's `[` would error on it, which reads as "not below 4.10").
preflight() {
  MODEL=$(tr -d '\0' 2>/dev/null < "$ROOT/proc/device-tree/model" || true)
  HWMODEL=$(tr -d '\0' 2>/dev/null < "$ROOT/proc/gl-hw-info/model" || true)
  case "$MODEL:$HWMODEL" in
    *E5800*|*e5800*) say "target OK: ${MODEL:-$HWMODEL}" ;;
    *) die "REFUSING: this is not a GL-E5800 (got: '${MODEL:-unknown}' / '${HWMODEL:-unknown}')" ;;
  esac
  [ "${1:-}" = model ] && return 0
  GLVER=$(tr -d '\r\n' 2>/dev/null < "$ROOT/etc/glversion" || true)
  GLMAJ=${GLVER%%.*}; GLREST=${GLVER#*.}; GLMIN=${GLREST%%.*}
  case "$GLMAJ$GLMIN" in *[!0-9]*|"") GLMAJ=0; GLMIN=0 ;; esac
  if [ -z "$GLVER" ] || [ "$GLMAJ" -lt 4 ] || { [ "$GLMAJ" -eq 4 ] && [ "$GLMIN" -lt 10 ]; }; then
    echo "REFUSING: MudiModem needs GL firmware >= 4.10 (found '${GLVER:-unknown}')." >&2
    echo "          For 4.8.x use the 1.x line: MUDIMODEM_REF=legacy-4.8 sh install.sh" >&2
    exit 1
  fi
  say "firmware OK: $GLVER"
}

# ---- manifest -----------------------------------------------------------------------------------
# Emit the manifest's records without comments/blank lines: "<type> <a> <b> <c>".
records() { sed -e 's/#.*$//' -e '/^[[:space:]]*$/d' "$1"; }

sources() {
  records "$1" | while read -r t a b c; do
    case "$t" in file|gz|cache|default) echo "$a" ;; esac
  done
}

# Is $1 a readable AT-library cache (intact gzip of JSON with entries + revision)?
lib_ok() { gzip -t "$1" 2>/dev/null && gzip -dc "$1" 2>/dev/null | grep -q '"entries"' && gzip -dc "$1" 2>/dev/null | grep -q '"revision"'; }

# The keep list abfota_update reads (one literal path per line, no globs, a directory keeps its
# tree; only /etc /usr /lib /bin /sbin /data /var survive). Our own directories, every placed
# file outside them, the list itself, and each service's procd enable links (S<START>/K<STOP>,
# read from its init script) — without those a service comes back disabled after an upgrade.
keepd() {
  m="$1"; dir="$2"
  echo "# MudiModem — files a GL firmware upgrade (abfota_update, Keep Settings) must carry over."
  echo "# GENERATED by mudimodem-install from manifest.txt at install time; do not edit."
  records "$m" | while read -r t a b c; do if [ "$t" = keepd ]; then echo "$a"; fi; done
  owns=$(records "$m" | while read -r t a b c; do if [ "$t" = own ]; then echo "$a"; fi; done)
  for o in $owns; do echo "$o"; done
  records "$m" | while read -r t a b c; do
    case "$t" in file|gz|cache|default) ;; *) continue ;; esac
    for o in $owns; do case "$b" in "$o"*) continue 2 ;; esac; done
    echo "$b"
  done
  records "$m" | while read -r t a b c; do
    [ "$t" = service ] || continue
    init=$(records "$m" | while read -r t2 a2 b2 c2; do if [ "$b2" = "/etc/init.d/$a" ]; then echo "$a2"; fi; done)
    if [ -z "$init" ] || [ ! -f "$dir/$init" ]; then continue; fi
    st=$(sed -n 's/^START=//p' "$dir/$init"); sp=$(sed -n 's/^STOP=//p' "$dir/$init")
    if [ -n "$st" ]; then echo "/etc/rc.d/S$st$a"; fi
    if [ -n "$sp" ]; then echo "/etc/rc.d/K$sp$a"; fi
  done
}

# ---- placement ----------------------------------------------------------------------------------
# Write via a sibling temp file + rename, so a reader (nginx, procd) never sees half a file.
put() {  # $1 type, $2 src (in payload), $3 dest, $4 mode
  dst="$ROOT$3"; mkdir -p "$(dirname "$dst")"
  case "$1" in
    file)    cat "$FROM/$2" > "$dst.mm-new" ;;
    gz)      gzip -9 -c < "$FROM/$2" > "$dst.mm-new" ;;   # stdin: no name/mtime in the header, so reinstalls are byte-identical
    cache)
      if lib_ok "$dst"; then say "  $3 (kept: existing library cache)"; log "keep $3"; return 0; fi
      # 2.0.0 kept the cache under /www; carry a refreshed copy over instead of the snapshot.
      if lib_ok "$ROOT/www/mudimodem/at-library.json.gz"; then
        cat "$ROOT/www/mudimodem/at-library.json.gz" > "$dst.mm-new"
      else
        gzip -9 -c < "$FROM/$2" > "$dst.mm-new"
      fi ;;
    default)
      if [ -e "$dst" ]; then log "keep $3"; return 0; fi
      cat "$FROM/$2" > "$dst.mm-new" ;;
  esac
  chmod "$4" "$dst.mm-new"
  mv -f "$dst.mm-new" "$dst"
  say "  $3"; log "place $3"
}

# ---- leftovers of older lines -------------------------------------------------------------------
# 1.x shipped a front-LCD renderer (mudi.py + mudi/mudi-watch services) that seizes the panel.
purge_lcd() {
  if [ -x "$ROOT/etc/init.d/mudi" ] || [ -x "$ROOT/etc/init.d/mudi-watch" ] || [ -f "$ROOT/usr/bin/mudi.py" ]; then
    say "removing 1.x LCD renderer leftovers:"
    for s in mudi mudi-watch; do
      if [ -x "$ROOT/etc/init.d/$s" ]; then
        svc "$s" stop; svc "$s" disable
        rm -f "$ROOT/etc/init.d/$s"; say "  /etc/init.d/$s stopped + removed"
      fi
    done
    rm -f "$ROOT/usr/bin/mudi.py" "$ROOT/usr/bin/mudi-watch.py" "$ROOT/etc/config/mudi"
    svc gl_screen start
    f="$ROOT/etc/sysupgrade.conf"
    if [ -f "$f" ]; then
      for p in /usr/bin/mudi.py /usr/bin/mudi-watch.py /etc/init.d/mudi /etc/init.d/mudi-watch /etc/config/mudi; do
        grep -vxF "$p" "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f" || rm -f "$f.tmp"
      done
    fi
  fi
}
# 2.0.0 kept its web payload in /www and registered its files in /etc/sysupgrade.conf (never read
# on the E5800); every one of those entries names mudimodem or glbattlimit.
purge_200() {
  rm -f "$ROOT"/www/views/gl-sdk4-ui-mudimodem*.common.js.gz
  rm -rf "$ROOT/www/mudimodem"
  f="$ROOT/etc/sysupgrade.conf"
  if [ -f "$f" ] && grep -q -e mudimodem -e glbattlimit "$f"; then
    grep -v -e mudimodem -e glbattlimit "$f" > "$f.tmp" || true
    cat "$f.tmp" > "$f"; rm -f "$f.tmp"
    say "  2.0.0 sysupgrade.conf entries removed"
  fi
}

# A charge-limit watcher started by an older glbattlimit from the web panel inherited nginx's
# listening sockets (the new nginx could not bind 80/443 while it lives), and replacing the binary
# under a running watcher is racy: release the limit and kill any survivor ([t]: never match us).
stop_battlimit() {
  [ -x "$ROOT/usr/bin/glbattlimit" ] && sys "glbattlimit off" "$ROOT/usr/bin/glbattlimit" off
  if [ -n "$ROOT" ]; then log "sys kill glbattlimit watchers"; return 0; fi
  for p in $(pgrep -f 'glbattlimi[t] _watch' 2>/dev/null); do kill -9 "$p" 2>/dev/null || true; done
}

# ---- install ------------------------------------------------------------------------------------
do_install() {
  parse "$@"
  [ -n "$FROM" ] && [ -f "$FROM/manifest.txt" ] || die "install needs --from <payload dir with manifest.txt>"
  M="$FROM/manifest.txt"
  preflight
  # The whole payload must be here BEFORE anything is touched.
  for s in $(sources "$M"); do [ -f "$FROM/$s" ] || die "payload is missing $s"; done
  VER=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$FROM/version.json" 2>/dev/null | head -n1)
  [ -n "$VER" ] || die "payload has no version.json"
  [ -n "$ROOT" ] && : > "$ACTIONS"

  stop_battlimit

  say "installing files:"
  records "$M" | while read -r t a b c; do
    case "$t" in file|gz|cache|default) put "$t" "$a" "$b" "$c" ;; esac
  done

  # python3 for the daemons (opkg; a firmware upgrade wipes it) BEFORE any service starts — their
  # init scripts would otherwise spawn a heal that races this opkg run. Offline-tolerant.
  sys "deps install" "$ROOT/usr/lib/mudimodem/mudimodem-deps" install

  # RESTART, not reload: nginx caches the plugin per worker. ~1 s admin blip, no link touch.
  svc nginx restart

  purge_lcd
  purge_200

  say "starting services:"
  records "$M" | while read -r t a b c; do
    [ "$t" = service ] || continue
    for act in $(echo "$b" | tr ',' ' '); do svc "$a" "$act"; done
    say "  $a ($b)"
  done

  kp=$(records "$M" | while read -r t a b c; do if [ "$t" = keepd ]; then echo "$a"; fi; done)
  mkdir -p "$(dirname "$ROOT$kp")"
  keepd "$M" "$FROM" > "$ROOT$kp.mm-new" && chmod 0644 "$ROOT$kp.mm-new" && mv -f "$ROOT$kp.mm-new" "$ROOT$kp"
  say "registered for firmware upgrades: $kp"; log "place $kp"

  # Last: a half-done install must not claim the new version (the Config tab would stop offering
  # the update that finishes it). The base is recorded so updates follow the same fork/branch.
  mkdir -p "$ROOT/etc/mudimodem"
  printf '{"version":"%s","base":"%s"}\n' "$VER" "${BASE:-unknown}" > "$ROOT/etc/mudimodem/version.json.mm-new"
  chmod 0644 "$ROOT/etc/mudimodem/version.json.mm-new"
  mv -f "$ROOT/etc/mudimodem/version.json.mm-new" "$ROOT/etc/mudimodem/version.json"
  log "place /etc/mudimodem/version.json"
  say ""
  say "MudiModem $VER installed. Reload the GL admin in your browser - a MODEM item appears in"
  say "the top navigation. No reboot needed."
}

# ---- uninstall ----------------------------------------------------------------------------------
do_uninstall() {
  parse "$@"
  if [ -n "$FROM" ]; then M="$FROM/manifest.txt"; else M="$ROOT/usr/lib/mudimodem/manifest.txt"; fi
  [ -f "$M" ] || die "no manifest (installed copy missing and no --from given)"
  # Read the manifest into memory: it lives in a directory this function deletes.
  RECS=$(records "$M")
  preflight model
  [ -n "$ROOT" ] && : > "$ACTIONS"

  # FIRST: a change still inside its confirm-or-revert window exists only as the pending file +
  # a sleeping watchdog. Deleting them would make the trial change permanent, so undo it now (the
  # same synchronous restore "Revert now" runs, while nginx/gl-session are still up) and refuse
  # to go on if that fails — the watchdog then stays armed.
  if [ -f "$ROOT/etc/mudimodem/pending" ]; then
    say "an unconfirmed band/cell-lock change is pending - reverting it first:"
    if [ -x "$ROOT/usr/sbin/mudimodem-revert" ] && out=$("$ROOT/usr/sbin/mudimodem-revert" restore-now 2>&1); then
      say "  $out"
    else
      echo "  ${out:-/usr/sbin/mudimodem-revert is missing}" >&2
      echo "ABORTING: the pending change could not be reverted; removing MudiModem now would keep it." >&2
      echo "  Retry in a minute, or run: /usr/sbin/mudimodem-revert panic" >&2
      echo "  (or keep the change: rm /etc/mudimodem/pending) and re-run the uninstaller." >&2
      exit 1
    fi
  fi
  # Stand down a watchdog still sleeping and a boot-check retry loop ([t]: never match us).
  if [ -n "$ROOT" ]; then log "sys kill watchdogs"; else
    for p in $(pgrep -f 'mudimodem-rever[t] watch' 2>/dev/null) $(pgrep -f 'mudimodem-rever[t] boot-check' 2>/dev/null); do
      kill "$p" 2>/dev/null || true
    done
  fi

  # Release the charge limit before its binary goes (restores the factory charge path).
  stop_battlimit

  say "stopping services:"
  echo "$RECS" | while read -r t a b c; do if [ "$t" = service ]; then echo "$a"; fi; done | sed -n '1!G;h;$p' |
    while read -r s; do svc "$s" stop; svc "$s" disable; say "  $s"; done

  purge_lcd

  say "removing files:"
  echo "$RECS" | while read -r t a b c; do
    case "$t" in
      file|gz|cache|default|keepd) p="$b"; if [ "$t" = keepd ]; then p="$a"; fi
        if [ -e "$ROOT$p" ]; then rm -f "$ROOT$p"; say "  $p"; log "remove $p"; fi ;;
    esac
  done
  echo "$RECS" | while read -r t a b c; do
    if [ "$t" = own ] && [ -e "$ROOT$a" ]; then rm -rf "$ROOT$a"; say "  $a"; log "remove $a"; fi
  done

  purge_200

  # Drop the cached RPC plugin and our gl-conf.d alias; the removed chunks 404.
  svc nginx restart
  say ""
  say "MudiModem removed. Reload the GL admin - the MODEM item is gone. No reboot needed."
  say "(A band/cell lock you set lives in modem NV and is unaffected.)"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  preflight) preflight "${1:-}" ;;
  install)   do_install "$@" ;;
  uninstall) do_uninstall "$@" ;;
  keepd)     parse "$@"; [ -n "$FROM" ] || die "keepd needs --from"; keepd "$FROM/manifest.txt" "$FROM" ;;
  sources)   parse "$@"; [ -n "$FROM" ] || die "sources needs --from"; sources "$FROM/manifest.txt" ;;
  *) echo "usage: $0 preflight|install|uninstall|keepd|sources ..." >&2; exit 2 ;;
esac
