#!/bin/sh
#
# glbattlimit - charge limit for GL.iNet Mudi 7 (GL-E5800)
#
#   glbattlimit on [PERCENT]   enable limit (default 80)
#   glbattlimit off            disable limit, normal charging
#   glbattlimit status         show current state
#
# The watcher terminates itself when the charger is unplugged and restores
# the factory state, so the next plug-in charges normally again.
#
# How it works (verified on firmware 4.8.5):
#   1. SGM41600 switched-capacitor charger (2:1) -> charge_en = 0
#      quec_battery then re-enables the SGM41542S buck charger.
#   2. SGM41542S buck -> vreg set below the current cell voltage
#      so the buck does not charge either. Result: 0 mA charge current.
#
# Both writes are restrictive only (vreg << bat_ovp_uv = 4.4 V).
# Overcharging is impossible; on any failure the device just charges normally.
#
# https://github.com/ChiliApple/mudi7-battery-limit
#

# Test hooks only (unset in production): GLBATTLIMIT_ROOT prefixes every sysfs
# and /tmp path below, GLBATTLIMIT_POLL overrides the poll interval.
R="${GLBATTLIMIT_ROOT:-}"
BAT=$R/sys/class/power_supply/cw221X-bat
CHG=$R/sys/class/power_supply/charger
PUMP=$R/sys/class/power_supply/sgm41600-standalone/device/sgm41600
BUCK=$R/sys/class/power_supply/charger/device/sgm41542s

VREG_NORMAL=4400000       # factory constant-voltage target (uV) — LAST-RESORT restore only
VREG_FLOOR=3900000        # lowest value used for gating (uV)
VREG_MARGIN=150           # mV below current terminal voltage
DEF_LIMIT=80
POLL=${GLBATTLIMIT_POLL:-15}
PIDF=$R/tmp/glbattlimit.pid
LIMF=$R/tmp/glbattlimit.limit
GATEF=$R/tmp/glbattlimit.gate     # the vreg WE wrote while gating (absent = not gating)
VREGF=$R/tmp/glbattlimit.vreg     # GL's own vreg, saved when we gated, restored on release
# MudiModem's fd-closing launcher (see `on`); absent when used standalone.
DETACH="${MUDIMODEM_DETACH:-/usr/lib/mudimodem/mudimodem-detach}"

# --- gauge <-> GUI conversion (PROVISIONAL) -------------------------------
# The GL.iNet GUI/touchscreen does not show the fuel gauge value. Measured
# pairs fit a straight line very closely (4 points, max deviation 0.5 pt):
#
#   GUI = 1.3867 * gauge - 18.93
#
# Extrapolated, GUI 100 % is gauge ~86 and GUI 0 % is gauge ~14, i.e. the GUI
# stretches the usable window onto 0-100 - consistent with the `v42_cap`
# symbol in quec_battery (capacity referenced to a 4.2 V full charge on a
# 4.4 V cell). Only validated between gauge 62 and 78; treat values outside
# that band as estimates. Scaled integer math, no floating point in ash.
GUI_M=13867          # slope  * 10000
GUI_B=189300         # offset * 10000 (subtracted)

# Rounded, not truncated: ash does integer division, so half the divisor is
# added before dividing. Truncating here cost about one point per conversion
# and two on a round trip.
gauge2gui() { g=$(( ($1 * GUI_M - GUI_B + 5000) / 10000 ))
              [ "$g" -lt 0 ] && g=0; [ "$g" -gt 100 ] && g=100; echo "$g"; }
gui2gauge() { echo $(( ($1 * 10000 + GUI_B + GUI_M / 2) / GUI_M )); }

log() { logger -t glbattlimit "$*"; }

need() {
    for f in "$BAT/capacity" "$BAT/voltage_now" "$BAT/current_now" \
             "$CHG/online" "$PUMP/charge_en" "$BUCK/vreg"; do
        if [ ! -e "$f" ]; then
            echo "ERROR: $f missing - wrong model or firmware."
            exit 1
        fi
    done
}

cap()     { cat "$BAT/capacity"; }
vnow_mv() { echo $(( $(cat "$BAT/voltage_now") / 1000 )); }
online()  { cat "$CHG/online"; }

# The buck's vreg is NOT ours alone: GL's quec_battery (procd, START=04) sets
# it itself — read in the 4.10 image, thermal_battery_state_change ->
# set_sgm41542s_func: 4180 mV when the cell is warm, charge current 0 when
# hot, and by cycle count 4250-4400 mV as the cell ages, rewritten on every
# thermal-state change. So the gate remembers the value GL had set and puts
# exactly that back; it never writes vreg while not gating (a fixed 4.4 V
# every poll overrode GL's warm/aged derating).
gate_on() {
    cur=$(cat "$BUCK/vreg" 2>/dev/null)
    # Not the value we last wrote (first gate, or quec_battery rewrote it on a
    # thermal change while we gated): that is GL's current choice — keep it.
    if [ -n "$cur" ] && [ "$cur" != "$(cat "$GATEF" 2>/dev/null)" ]; then
        echo "$cur" > "$VREGF"
    fi
    t=$(( $(vnow_mv) - VREG_MARGIN ))
    t=$(( t * 1000 ))
    [ "$t" -lt "$VREG_FLOOR" ] && t=$VREG_FLOOR
    gl=$(cat "$VREGF" 2>/dev/null)
    [ -n "$gl" ] && [ "$t" -gt "$gl" ] && t=$gl      # never above what GL allows
    echo 0 > "$PUMP/charge_en" 2>/dev/null
    echo "$t" > "$BUCK/vreg" 2>/dev/null
    echo "$t" > "$GATEF"
}

# Release: only when we gated, and only back to GL's own value. If GL rewrote
# vreg since our last write, its value already stands — leave it. Do NOT
# write charge_en=2 ourselves: the SGM41600 is a slave charger and switching
# it back is the host's job; the pump returns on the next plug event.
gate_off() {
    [ -f "$GATEF" ] || return 0
    if [ "$(cat "$BUCK/vreg" 2>/dev/null)" = "$(cat "$GATEF" 2>/dev/null)" ]; then
        gl=$(cat "$VREGF" 2>/dev/null)
        echo "${gl:-$VREG_NORMAL}" > "$BUCK/vreg" 2>/dev/null
    fi
    rm -f "$GATEF" "$VREGF"
}

# Is $1 a live watcher? kill -0 alone also matches a zombie, or an unrelated
# process that reused the pid of a SIGKILLed watcher whose PIDF survived.
watcher_alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1
    [ -r "/proc/$1/cmdline" ] || return 0
    tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q '_watch'
}

# Stop the watcher and wait (bounded) until it is really gone, so a re-run of
# `on` never starts the successor while the old one can still exit under it.
# The watcher dies at once (its sleep is interruptible); one still alive after
# ~5 s is killed outright (no trap runs then, so the files are removed here).
stop_watcher() {
    p=$(cat "$PIDF" 2>/dev/null)
    if watcher_alive "$p"; then
        kill "$p" 2>/dev/null
        i=0
        while watcher_alive "$p" && [ "$i" -lt 25 ]; do
            sleep 0.2 2>/dev/null || { sleep 1; i=$((i + 4)); }   # no float sleep: 1 s steps
            i=$((i + 1))
        done
        watcher_alive "$p" && kill -9 "$p" 2>/dev/null
    fi
    gate_off          # a SIGKILLed watcher ran no trap; a no-op when nothing is gated
    rm -f "$PIDF" "$LIMF"
}

# Only the watcher PIDF names owns the gate and the state files. One that lost
# them (a racing `on` started another) exits without touching either:
# deleting its successor's PIDF would make the UI read the limit as off and
# leave `off` unable to find the watcher that still holds it.
owns_pidf() { [ "$(cat "$PIDF" 2>/dev/null)" = "$$" ]; }

watch_loop() {
    echo $$ > "$PIDF"
    lim=$(cat "$LIMF" 2>/dev/null)
    [ -z "$lim" ] && lim=$DEF_LIMIT
    slp=""
    trap '[ -n "$slp" ] && kill "$slp" 2>/dev/null
          if owns_pidf; then gate_off; rm -f "$PIDF" "$LIMF"; log "stopped, limit released"
          else log "stopped (superseded)"; fi
          exit 0' INT TERM
    log "active, limit ${lim}%"
    while :; do
        owns_pidf || { log "superseded by $(cat "$PIDF" 2>/dev/null) - exiting"; exit 0; }
        if [ "$(online)" != "1" ]; then
            gate_off
            rm -f "$PIDF" "$LIMF"
            log "unplugged - GL's charge voltage restored"
            exit 0
        fi
        if [ "$(cap)" -ge "$lim" ]; then gate_on; else gate_off; fi
        # Background + wait: a trapped signal interrupts `wait` at once, while
        # a foreground sleep would defer the trap for up to POLL seconds.
        sleep "$POLL" &
        slp=$!
        wait "$slp"
        slp=""
    done
}

case "$1" in
  on)
    need
    l="$2"
    [ -z "$l" ] && l=$DEF_LIMIT
    case "$l" in
        ''|*[!0-9]*) echo "Invalid value: $l"; exit 1 ;;
    esac
    if [ "$3" = "gui" ]; then
        if [ "$l" -lt 20 ] || [ "$l" -gt 100 ]; then
            echo "GUI value must be between 20 and 100."
            exit 1
        fi
        g=$(gui2gauge "$l")
        echo "GUI ${l} % -> gauge ${g} % (estimate, see README)"
        l=$g
    fi
    if [ "$l" -lt 50 ] || [ "$l" -gt 100 ]; then
        echo "Limit must be between 50 and 100 (gauge scale)."
        exit 1
    fi
    stop_watcher
    if [ "$(online)" != "1" ]; then
        echo "No charger connected - nothing to do."
        exit 1
    fi
    echo "$l" > "$LIMF"
    # `on` also runs inside an nginx worker (the web backend's io.popen): a
    # plain background child would keep nginx's listening sockets open for as
    # long as the charger stays plugged in, and nginx could not rebind 80/443
    # on restart. MudiModem's launcher closes every inherited fd and setsid's;
    # standalone (no MudiModem installed) falls back to nohup.
    if [ -x "$DETACH" ]; then
        "$DETACH" "$0" _watch </dev/null >/dev/null 2>&1 &
    else
        nohup "$0" _watch </dev/null >/dev/null 2>&1 &
    fi
    sleep 2
    echo "Charge limit active: $l % gauge / ~$(gauge2gui $l) % GUI"
    echo "Currently: $(cap) % gauge / ~$(gauge2gui "$(cap)") % GUI"
    echo "Released automatically when the charger is unplugged."
    ;;

  off)
    need
    stop_watcher
    gate_off
    echo "Charge limit off - normal charging."
    echo "Full charge current returns after the next unplug/plug cycle."
    ;;

  status)
    need
    p=$(cat "$PIDF" 2>/dev/null)
    if watcher_alive "$p"; then
        lm=$(cat $LIMF 2>/dev/null)
        echo "Limit     : active ($lm % gauge / ~$(gauge2gui $lm) % GUI, PID $p)"
    else
        echo "Limit     : off"
    fi
    echo "Capacity  : $(cap) % gauge / ~$(gauge2gui "$(cap)") % GUI (estimated)"
    echo "Voltage   : $(vnow_mv) mV"
    echo "Current   : $(cat $BAT/current_now) mA  (+charging -discharging 0=blocked)"
    echo "Charger   : online=$(online)"
    echo "Pump      : charge_en=$(cat $PUMP/charge_en)  (0=off 1=bypass 2=2:1)"
    echo "Buck vreg : $(cat $BUCK/vreg) uV  ($( [ -f "$GATEF" ] && echo "gated; GL's value $(cat "$VREGF" 2>/dev/null)" || echo "GL's own value"))"
    ;;

  _watch)
    watch_loop
    ;;

  *)
    echo "glbattlimit - charge limit for GL.iNet Mudi 7 (GL-E5800)"
    echo ""
    echo "  glbattlimit on [PERCENT]       enable limit, gauge scale (default $DEF_LIMIT)"
    echo "  glbattlimit on [PERCENT] gui   enable limit, GUI scale (converted)"
    echo "  glbattlimit off                disable limit"
    echo "  glbattlimit status             show state"
    echo ""
    echo "  Gauge and GUI use different scales - see status output."
    exit 1
    ;;
esac

exit 0
