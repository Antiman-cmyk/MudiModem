#!/usr/bin/python3
# mudimodem-collectd — background modem-history collector for MudiModem (GL 4.10).
#
# Every POLL_INTERVAL it reads GL's cellular ubus for the ACTIVE slot and appends
# one normalized sample (cellular_compat.build_sample: signals[] + PCC aliases)
# to /tmp/mudimodem/samples.jsonl, writes latest.json and publishes it to the
# web UI over GL's own websocket bus (`ubus call gl-session notify
# {name:"mudimodem.collect", data}`; battery samples go out as
# mudimodem.battery), so no page ever polls for live data. gl-session's notify
# is a no-op with no browser attached, so it is called unconditionally.
#
# ⚠️ `cellular.network cell_info` is NOT a cache read on 4.10: its handler
# executes AT+QENG / AT+QCAINFO on the shared AT channel every call. That is
# why the default cadence is 10 s (GL's own signal log polls at 10 s) and
# why nothing else here touches the modem: carrier/identity come from
# `cellular.network info` at a slow cadence, battery from sysfs only.
#
# Live storage is tmpfs (RAM). Optional eMMC backup (Config → keep history
# across reboots) periodically APPENDs new lines to /etc/mudimodem/history/
# (two rotating segments per stream, see rotate_segment) and seeds tmpfs from
# that on boot — off by default.
#
# Every interval/gate here (tick sleep, battery cadence, eMMC flush, push
# probe, carrier cache, log rate limits) runs on time.monotonic(): a wall
# clock stepped BACKWARD (NTP correcting a fast clock, a manual set) would
# otherwise stall sampling and pushes for the size of the step. Sample
# timestamps (`t`) stay wall-clock epoch ms — that is what the charts plot.
#
# Stdlib only; shares cellular_compat.py (/usr/lib/mudimodem). Managed by
# procd (/etc/init.d/mudimodem-collectd), respawned on crash.
#
# Env overrides (tests): MUDIMODEM_HIST (dir), MUDIMODEM_POLL (seconds),
# MUDIMODEM_CARRIER_INTERVAL, MUDIMODEM_HISTORY_CFG, MUDIMODEM_HISTORY_PERSIST,
# MUDIMODEM_FLUSH_INTERVAL, MUDIMODEM_NO_WS_PUSH=1 (skip gl-session notify).

import json
import os
import signal
import subprocess
import sys
import time

_HERE = os.path.dirname(os.path.abspath(globals().get("__file__") or sys.argv[0] or "."))
for _d in ("/usr/lib/mudimodem", os.path.join(_HERE, "..", "lib")):
    if os.path.isdir(_d) and _d not in sys.path:
        sys.path.insert(0, _d)
import cellular_compat as cc  # noqa: E402

BUS             = os.environ.get("MUDIMODEM_BUS", "cpu")
POLL_INTERVAL   = float(os.environ.get("MUDIMODEM_POLL", "10"))
CARRIER_INTERVAL = float(os.environ.get("MUDIMODEM_CARRIER_INTERVAL", "60"))
SAMPLE_MAX_AGE  = 24 * 3600 * 1000     # 24 h, in ms
SAMPLE_MAX_LINE = 9000                  # 24h at 10s = 8640; hard backstop above that
TRIM_EVERY      = 60                     # ~10 min at 10 s (trim() is O(dropped); the cap absorbs the overshoot)
EVENT_TRIM_EVERY = 360                   # ~1 h
WS_NAME         = "mudimodem.collect"    # global_sockets names the page subscribes to
WS_BATT_NAME    = "mudimodem.battery"
WS_PUSH         = os.environ.get("MUDIMODEM_NO_WS_PUSH") != "1"

# ---- battery (issue #1) ---------------------------------------------------
# Sampled from sysfs only: no ubus, no AT, nothing that can contend with the
# modem channel. Slower cadence than the modem because the values move slowly —
# SoC is an integer % that changes every ~60-90 s while charging.
BATT_INTERVAL   = float(os.environ.get("MUDIMODEM_BATT_INTERVAL", "20"))
BATT_MAX_AGE    = 24 * 3600 * 1000      # 24 h, in ms
BATT_MAX_LINE   = 5200                  # 24h at 20s = 4320; backstop above that
BATT_SYSFS      = os.environ.get("MUDIMODEM_BATT_SYSFS", "/sys/class/power_supply")
# glbattlimit's own runtime state. Both files are created by its watcher and
# removed when it exits (including on unplug), so their presence — plus a
# liveness check on the pid, exactly as `glbattlimit status` does — is the
# authoritative "the limiter is running" signal. Recorded PER SAMPLE because it
# is history: a settings change mid-window must not retroactively relabel the
# samples that came before it.
BATT_LIMIT_PIDF = os.environ.get("MUDIMODEM_BATTLIMIT_PIDF", "/tmp/glbattlimit.pid")
BATT_LIMIT_LIMF = os.environ.get("MUDIMODEM_BATTLIMIT_LIMF", "/tmp/glbattlimit.limit")

# ---- optional eMMC backup (approach #2) -----------------------------------
# Live path is always tmpfs. When enabled, every FLUSH_INTERVAL we APPEND only
# the new lines to /etc/mudimodem/history/ (overlay/eMMC). On startup we seed
# empty tmpfs from that backup so charts survive reboot. Off by default —
# see /etc/mudimodem/history.json { "enabled": false }.
# Each stream is TWO segments, <stream>.prev.jsonl + <stream>.jsonl (the
# current one, appended to) — see rotate_segment for why that is the flash-
# friendly shape.
HISTORY_CFG = os.environ.get("MUDIMODEM_HISTORY_CFG",
                             "/etc/mudimodem/history.json")
HISTORY_PERSIST = os.environ.get("MUDIMODEM_HISTORY_PERSIST",
                                 "/etc/mudimodem/history")
FLUSH_INTERVAL = float(os.environ.get("MUDIMODEM_FLUSH_INTERVAL", "600"))  # 10 min


def now_ms():
    return int(time.time() * 1000)


def write_latest(path, sample):
    """Atomically write the newest sample so a just-connected consumer (or a
    debugger) can read current state without waiting for the next tick."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(sample))
    os.replace(tmp, path)


def ubus_call(obj, method, args=None):
    """Return the parsed ubus result dict, or None on any failure."""
    try:
        out = subprocess.run(["ubus", "call", obj, method, json.dumps(args or {})],
                             capture_output=True, timeout=8, text=True)
        if out.returncode != 0 or not out.stdout:
            return None
        return json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def _num(v):
    return cc.normalize_metric(v)


def build_sample(modem, cell_info, networks_info=None, t=None, carrier=None):
    """Pure: one normalized sample (cellular_compat.build_sample) stamped with
    the box clock. None when the active slot can't be resolved."""
    s = cc.build_sample(modem, cell_info, networks_info, t=t, bus=BUS, carrier=carrier)
    if s is not None and s["t"] is None:
        s["t"] = now_ms()
    return s


class Gate:
    """Fires at most once per `interval` seconds of MONOTONIC time (and on the
    first look). Used for every cadence in the loop, so a wall-clock step can
    neither stall nor burst them."""

    def __init__(self, interval):
        self.interval = interval
        self.last = None

    def due(self, now=None):
        now = time.monotonic() if now is None else now
        if self.last is not None and now - self.last < self.interval:
            return False
        self.last = now
        return True


class CarrierCache:
    """`cellular.network info` is the identity/carrier source (the same call
    GL's ws merge layer uses). It is re-read only every CARRIER_INTERVAL or
    when the active slot changes — never per tick."""

    def __init__(self):
        self.at = 0.0
        self.slot = None
        self.info = None

    def get(self, slot):
        now = time.monotonic()
        if self.info is None or slot != self.slot or now - self.at >= CARRIER_INTERVAL:
            self.info = ubus_call("cellular.network", "info") or {}
            self.at = now
            self.slot = slot
        return self.info


_carrier = CarrierCache()

# ---- a FAILED cell_info read is not "no service" ---------------------------
# ubus_call returns None on rc != 0 / the 8 s timeout / bad JSON, and GL's
# error replies carry no `network_type`. Fed to build_sample, either one
# normalized exactly like a no-service cell (registered:false, null metrics):
# a fake outage in the history, on the strip and in "SIM N is not registered".
# A genuine no-service reply always HAS network_type (0) — that one still
# yields the honest no-service sample (cc.cell_info_failed tells them apart).
# A failed read skips the tick: no line, latest.json untouched, no push.
_cell_fail = {"n": 0, "last_log": None}
CELL_FAIL_LOG_EVERY_S = 300


def _cell_failure(cell):
    """Count one failed read; say so on stderr (procd -> logd) at once, then at
    most every CELL_FAIL_LOG_EVERY_S — a wedged modem stack must be visible in
    logread without a line every 10 s."""
    _cell_fail["n"] += 1
    now = time.monotonic()
    last = _cell_fail["last_log"]
    if last is None or now - last >= CELL_FAIL_LOG_EVERY_S:
        _cell_fail["last_log"] = now
        detail = "no reply (ubus failed or timed out)" if cell is None else \
            "error reply %s" % json.dumps(cell)[:200]
        sys.stderr.write("collectd: cell_info read failed, tick skipped (%d so far): %s\n"
                         % (_cell_fail["n"], detail))
        sys.stderr.flush()


def collect_sample():
    """The 4.10 read path: modem status (active slot, GL's no-arg modems[] form),
    then ONE cell_info {bus,slot} (the AT-backed call — exactly once per tick),
    carrier from the slow identity cache. None = skip this tick: no active
    slot, or the cell_info read itself failed (cc.cell_info_failed)."""
    modem = ubus_call("cellular.modem", "status")
    slot = cc.active_slot(modem, BUS)
    if slot is None:
        return None
    cell = ubus_call("cellular.network", "cell_info", {"bus": BUS, "slot": slot})
    if cc.cell_info_failed(cell):
        _cell_failure(cell)
        return None
    if _cell_fail["n"]:
        sys.stderr.write("collectd: cell_info recovered after %d failed read(s)\n" % _cell_fail["n"])
        sys.stderr.flush()
        _cell_fail["n"] = 0
        _cell_fail["last_log"] = None
    return build_sample(modem, cell, _carrier.get(slot))


_ws_fail = {"n": 0, "last_log": None}
WS_FAIL_LOG_EVERY_S = 60

# ---- browser-presence gate for the push bus ---------------------------------
# gl-session's notify is a no-op with no websocket client (gl-ngx-session.lua:
# the handler loops over ws_clients and returns), so on a headless travel router
# every 10 s RF push and 20 s battery push was a pointless fork+exec of `ubus`
# (~13k a day). `gl-session has_websocket` answers {has_ws:bool}; probe it
# every WS_PROBE_IDLE_S while nobody is attached and skip the pushes, every
# WS_PROBE_ATTACHED_S once someone is. A page that opens between probes gets
# the /ws SEED (latest.json, <= one tick old) at once and its first live push
# within probe + tick <= 40 s — inside every stall guard (strip 45 s, tracking
# 45 s, battery 60 s), so nothing on screen changes. A failed probe counts as
# "attached": a dead gl-session must show up as logged push failures, never as
# silence.
WS_PROBE_IDLE_S     = float(os.environ.get("MUDIMODEM_WS_PROBE_IDLE", "30"))
WS_PROBE_ATTACHED_S = float(os.environ.get("MUDIMODEM_WS_PROBE_ATTACHED", "60"))
_ws_gate = {"attached": True, "at": None}


def ws_attached(now=None):
    """True when a browser is (or may be) subscribed; re-probed on the cadence
    above (monotonic seconds; `now` is for tests)."""
    now = time.monotonic() if now is None else now
    every = WS_PROBE_ATTACHED_S if _ws_gate["attached"] else WS_PROBE_IDLE_S
    if _ws_gate["at"] is not None and now - _ws_gate["at"] < every:
        return _ws_gate["attached"]
    _ws_gate["at"] = now
    attached = True
    try:
        out = subprocess.run(["ubus", "call", "gl-session", "has_websocket"],
                             capture_output=True, timeout=5, text=True)
        if out.returncode == 0 and out.stdout:
            attached = bool(json.loads(out.stdout).get("has_ws", True))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        attached = True
    _ws_gate["attached"] = attached
    return attached


def _ws_failure(detail):
    """Record one failed push and say so on stderr (procd forwards it to logd):
    the first failure immediately, then at most once a minute — a dead
    gl-session must be visible in logread without flooding it every 10 s."""
    _ws_fail["n"] += 1
    now = time.monotonic()
    if _ws_fail["n"] == 1 or _ws_fail["last_log"] is None \
            or now - _ws_fail["last_log"] >= WS_FAIL_LOG_EVERY_S:
        _ws_fail["last_log"] = now
        sys.stderr.write("collectd: gl-session notify failed (%d so far): %s\n"
                         % (_ws_fail["n"], detail))
        sys.stderr.flush()


def ws_publish(name, sample):
    """Push one frame to every web client subscribed to `name` via GL's own push
    bus — the same mechanism cellular_manager uses for cellular.modems_status.
    With no browser attached gl-session's handler simply has no client to send
    to and still returns status 0 (gl-ngx-session.lua `notify`), so a non-zero
    exit is ALWAYS a fault (gl-session not registered, ubusd down, message
    rejected) — logged, never swallowed. True iff the frame was accepted."""
    if not WS_PUSH:
        return False
    try:
        out = subprocess.run(["ubus", "call", "gl-session", "notify",
                              json.dumps({"name": name, "data": sample})],
                             capture_output=True, timeout=5, text=True)
    except (OSError, subprocess.TimeoutExpired) as e:
        _ws_failure(str(e))
        return False
    if out.returncode != 0:
        _ws_failure("rc=%d %s" % (out.returncode,
                                  ((out.stderr or out.stdout or "").strip())[:200]))
        return False
    if _ws_fail["n"]:
        sys.stderr.write("collectd: gl-session notify recovered after %d failure(s)\n" % _ws_fail["n"])
        sys.stderr.flush()
        _ws_fail["n"] = 0
    return True


def _readfile(path):
    """Read one small text file, stripped. None if absent or unreadable."""
    try:
        with open(path) as f:
            return f.read().strip()
    except (OSError, ValueError):
        return None


def _sysfs(root, rel):
    """Read one sysfs node, stripped. None if it is absent or unreadable."""
    return _readfile(os.path.join(root, rel))


def read_limiter(pidf=None, limf=None):
    """Is glbattlimit's watcher running, and at what gauge target?

    Returns (running: int 0|1, target_gauge: int|None).

    ⚠️ WHY THIS EXISTS. The charger reports `status=Full` + `charge_type=Trickle`
    BOTH when the cell is genuinely full and when glbattlimit is holding charge
    off — because the way it holds charge off is to write the buck's `vreg`
    below the current cell voltage (glbattlimit `gate_on`), which is precisely
    the condition a charger reports as "charge complete". So `status` CANNOT
    tell the two apart, and neither can `current_now == 0`. The limiter's own
    pid/limit files can, and they are the same signal `glbattlimit status`
    prints (and the backend's get_battlimit parses), so the chart and the
    charge-limit card cannot contradict each other.
    """
    pidf = BATT_LIMIT_PIDF if pidf is None else pidf
    limf = BATT_LIMIT_LIMF if limf is None else limf
    running = 0
    raw = _readfile(pidf)
    try:
        pid = int(raw)
    except (TypeError, ValueError):
        pid = 0
    if pid > 0:
        try:
            os.kill(pid, 0)          # signal 0 = liveness probe, like `kill -0`
            running = 1
        except PermissionError:
            running = 1              # alive, just not ours to signal
        except OSError:
            running = 0              # stale pidfile: watcher was killed hard
    target = _num(_readfile(limf))
    return running, (None if target is None else int(target))


def read_battery(root=None, t=None, pidf=None, limf=None):
    """One battery sample from /sys/class/power_supply, or None if the fuel
    gauge is unreadable (i.e. not this hardware) — in which case we write no
    battery file at all rather than a file full of nulls.

    ⚠️ UNITS ARE PER-NODE. There is no blanket rule here:
      voltage_now  uV        -> mV
      temp         deci-C    -> C
      current_now  mA ALREADY, signed. DO NOT divide by 1000.
                   +charging / -discharging / 0 = charging blocked.
                   The Linux power_supply class normally uses uA, so mA looks
                   wrong; glbattlimit line 166 documents it and the physics
                   agree (-363 at 4.0 V = 1.45 W; as uA it would be 1.5 mW).
    `cap` is stored as the RAW GAUGE %, never converted to GL's "GUI" scale:
    that conversion is a provisional linear fit, and storing the raw reading
    keeps retained history valid if the fit is ever corrected.

    `lim` / `lim_gauge` carry glbattlimit's state at the moment of the sample
    (see read_limiter) — the only thing that distinguishes "the limiter is
    holding charge off" from "the battery is full", since the charger reports
    Full/Trickle for both.
    """
    root = BATT_SYSFS if root is None else root
    bat, chg = "cw221X-bat", "charger"
    cap = _num(_sysfs(root, bat + "/capacity"))
    if cap is None:
        return None                              # no gauge => not this hardware
    volt = _num(_sysfs(root, bat + "/voltage_now"))
    temp = _num(_sysfs(root, bat + "/temp"))
    lim, lim_gauge = read_limiter(pidf, limf)
    return {
        "t": now_ms() if t is None else t,
        "cap": cap,
        "volt": None if volt is None else int(volt // 1000),
        "cur": _num(_sysfs(root, bat + "/current_now")),
        "temp": None if temp is None else round(temp / 10.0, 1),
        "online": int(_num(_sysfs(root, chg + "/online")) or 0),
        "status": _sysfs(root, chg + "/status") or "",
        "ctype": _sysfs(root, chg + "/charge_type") or "",
        "cycles": _num(_sysfs(root, bat + "/cycle_count")),
        "health": _sysfs(root, bat + "/health") or "",
        "lim": lim,
        "lim_gauge": lim_gauge,
    }


TRIM_GRACE_S = 0.2   # shared trim: how long the OLD inode is watched after the rename


def _line_t(raw):
    """The numeric `t` of one jsonl line (str or bytes), or None if the line
    is malformed or carries no usable t."""
    try:
        t = json.loads(raw).get("t")
    except (ValueError, AttributeError):
        return None
    return t if isinstance(t, (int, float)) and not isinstance(t, bool) else None


def _carry(src, dst, pos):
    """Copy every WHOLE line appended to `src` after byte `pos` into `dst`;
    returns the new position. Loops until the size stops moving. A trailing
    fragment (an append still being written) is left for the next look."""
    while True:
        size = os.fstat(src.fileno()).st_size
        if size <= pos:
            return pos
        src.seek(pos)
        chunk = src.read(size - pos)
        cut = chunk.rfind(b"\n") + 1
        if not cut:
            return pos
        dst.write(chunk[:cut])
        pos += cut


def trim(path, max_age_ms, max_lines, ref_ms=None, shared=False):
    """Drop lines older than max_age and cap the count, atomically. No-op if the
    file is absent — and no rewrite at all when nothing needs dropping.

    The file is append-ordered by t, so only the HEAD has to be parsed: walk
    from the top until the first line that is young enough (each parsed line
    is one that goes), then keep the rest verbatim. A whole-file parse and
    rewrite every pass — 8,640 json.loads + a 2 MB write every 2 min at 24 h —
    was the old cost; now it is O(lines dropped), ~60 every 10 min. Malformed
    lines can only be a torn TAIL (our own appender writes one atomic line at
    a time), so the last line is checked and scrubbed; readers skip junk
    anyway (read_window).

    `shared=True` is for a file OTHER processes append to while we trim —
    events.jsonl: the Lua backend's io.open(..,"a") and the watchdog's
    `echo >>`, one whole line per O_APPEND write, no lock we could take. A
    plain read -> rewrite -> rename loses every line appended between the
    read and the rename, so here: bytes after the last newline are an append
    still in flight (never scrubbed, never kept from the first read); whatever
    was appended while the kept lines were written is copied into the new
    file before the rename (_carry, until the size is stable); and a writer
    that opened the OLD inode just before the rename gets its line carried
    over for TRIM_GRACE_S after it (appended O_APPEND, so it lands after
    anything newer writers already put in the new file)."""
    try:
        src = open(path, "rb")
    except FileNotFoundError:
        return
    with src:
        data = src.read()
        if shared:
            data = data[:data.rfind(b"\n") + 1]
        pos = len(data)
        lines = data.splitlines(True)
        if not lines:
            return
        cutoff = (now_ms() if ref_ms is None else ref_ms) - max_age_ms
        drop = 0
        for ln in lines:
            t = _line_t(ln) if ln.strip() else None
            if t is not None and t >= cutoff:
                break
            drop += 1
        kept = lines[drop:]
        if kept and _line_t(kept[-1]) is None:          # torn tail line
            kept = kept[:-1]
        if len(kept) > max_lines:
            kept = kept[-max_lines:]
        if len(kept) == len(lines):
            return                                       # nothing to drop: leave the file alone
        tmp = path + ".tmp"
        with open(tmp, "wb") as dst:
            dst.write(b"".join(l if l.endswith(b"\n") else l + b"\n" for l in kept))
            if shared:
                pos = _carry(src, dst, pos)
        os.replace(tmp, path)
        if shared:
            deadline = time.monotonic() + TRIM_GRACE_S
            with open(path, "ab", buffering=0) as dst:   # unbuffered: one O_APPEND write per carry
                while True:
                    pos = _carry(src, dst, pos)
                    if time.monotonic() >= deadline:
                        break
                    time.sleep(0.05)


# ---- eMMC history backup helpers (pure; unit-tested) ----------------------

def read_history_config(path=None):
    """Return {enabled: bool}. Missing/malformed file → disabled (safe default)."""
    path = HISTORY_CFG if path is None else path
    out = {"enabled": False}
    try:
        with open(path) as f:
            obj = json.loads(f.read() or "{}")
    except (OSError, ValueError, TypeError):
        return out
    if isinstance(obj, dict) and obj.get("enabled") is True:
        out["enabled"] = True
    return out


def persist_segments(persist_dir, stream):
    """[previous, current] backup segments of one stream ("samples" /
    "battery"), oldest first. The current segment keeps the pre-rotation name,
    so a backup written by an older collector is simply read as `current`."""
    return [os.path.join(persist_dir, stream + ".prev.jsonl"),
            os.path.join(persist_dir, stream + ".jsonl")]


def max_t_in_file(path):
    """Largest sample `t` in a jsonl file, or 0 if absent/empty."""
    max_t = 0
    try:
        with open(path) as f:
            for ln in f:
                ln = ln.strip()
                if not ln:
                    continue
                t = _line_t(ln)
                if t is not None and t > max_t:
                    max_t = int(t)
    except FileNotFoundError:
        pass
    return max_t


def first_t_in_file(path, max_lines=50):
    """`t` of the oldest (first parseable) line, or None if absent/empty."""
    try:
        with open(path) as f:
            for n, ln in enumerate(f):
                if n >= max_lines:
                    break
                t = _line_t(ln.strip()) if ln.strip() else None
                if t is not None:
                    return t
    except FileNotFoundError:
        pass
    return None


def last_t_in_file(path, tail_bytes=16384):
    """`t` of the newest (last parseable) line — read from the tail only."""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - tail_bytes))
            chunk = f.read()
    except FileNotFoundError:
        return None
    for ln in reversed(chunk.splitlines()):
        t = _line_t(ln) if ln.strip() else None
        if t is not None:
            return t
    return None


def rotate_segment(prev, cur, span_ms, ref_ms=None):
    """Two-segment rotation of one backup stream — the reason the backup is
    append-only in steady state.

    The old scheme appended and then trim()med the single backup file every
    flush: once it held 24 h, each flush dropped ~60 head lines by REWRITING
    the whole multi-MB file on flash, ~144 times a day. Now the current
    segment is only ever appended to; once its OLDEST line is span_ms old it
    is RENAMED over the previous segment (a metadata operation: no data is
    copied) and the next flush starts a fresh current segment. With span =
    the retention window, prev + current always cover at least the whole
    window and at most two (restore filters to the window), and the only
    whole-file operation left is one rename per window per stream.

    When even the current segment's NEWEST line is outside the window (the
    backup was off, or the collector stopped, for over a window) both
    segments are deleted instead. Returns "rotated", "expired" or None."""
    head = first_t_in_file(cur)
    cutoff = (now_ms() if ref_ms is None else ref_ms) - span_ms
    if head is None or head > cutoff:
        return None
    last = last_t_in_file(cur)
    if last is None or last > cutoff:
        os.replace(cur, prev)
        return "rotated"
    for p in (prev, cur):
        try:
            os.remove(p)
        except FileNotFoundError:
            pass
    return "expired"


def seed_tmp_from_persist(tmp_path, segments, max_age_ms=None, ref_ms=None):
    """Boot restore: if the tmpfs file is empty/missing, rebuild it from the
    backup segments (a path or a list, oldest first), keeping only lines
    inside max_age_ms of now (None = keep everything). Returns True if a seed
    happened. Does not overwrite non-empty tmpfs (this boot may already have
    samples; a full merge is unnecessary and racy).

    Segments are append-ordered, so only each one's out-of-window HEAD is
    parsed; the rest is copied line by line (one line in memory, not the
    whole backup)."""
    if isinstance(segments, str):
        segments = [segments]
    try:
        if os.path.exists(tmp_path) and os.path.getsize(tmp_path) > 0:
            return False
    except OSError:
        pass
    cutoff = None if max_age_ms is None else \
        (now_ms() if ref_ms is None else ref_ms) - max_age_ms
    tmp = tmp_path + ".seed"
    wrote = False
    try:
        os.makedirs(os.path.dirname(tmp_path) or ".", exist_ok=True)
        with open(tmp, "w") as dst:
            for seg in segments:
                try:
                    src = open(seg)
                except OSError:
                    continue
                with src:
                    young = cutoff is None
                    for ln in src:
                        raw = ln.strip()
                        if not raw:
                            continue
                        if not young:
                            t = _line_t(raw)
                            if t is None or t < cutoff:
                                continue
                            young = True
                        dst.write(raw + "\n")
                        wrote = True
        if not wrote:
            os.remove(tmp)
            return False
        os.replace(tmp, tmp_path)
        return True
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return False


def flush_new_lines(tmp_path, persist_path, since_t):
    """Append jsonl lines from tmp_path with t > since_t onto persist_path.
    Returns the new since_t (max t flushed, or unchanged if nothing new).
    APPEND-ONLY — never rewrites the persist file (rotate_segment renames it)."""
    new_since = since_t
    try:
        with open(tmp_path) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return since_t
    out = []
    for ln in lines:
        raw = ln.strip()
        if not raw:
            continue
        t = _line_t(raw)
        if t is None:
            continue
        t = int(t)
        if t > since_t:
            out.append(raw)
            if t > new_since:
                new_since = t
    if not out:
        return since_t
    os.makedirs(os.path.dirname(persist_path) or ".", exist_ok=True)
    with open(persist_path, "a+b") as f:
        # A crash mid-append can leave a torn last line with no newline: start
        # on a fresh line so it can't swallow the first line of this batch.
        f.seek(0, 2)
        lead = b""
        if f.tell() > 0:
            f.seek(-1, 2)
            if f.read(1) != b"\n":
                lead = b"\n"
        f.write(lead + ("\n".join(out) + "\n").encode())
    return new_since


PERSIST_STREAMS = (("samples", SAMPLE_MAX_AGE), ("battery", BATT_MAX_AGE))


def maybe_flush_persist(samples_tmp, battery_tmp, persist_dir, cursors, ref_ms=None):
    """If config enabled, rotate each backup stream when due, then append the
    new tmpfs lines to its current segment. `cursors` is a mutable dict
    {samples, battery} of last-flushed t. Returns the enabled flag (so the
    caller can log transitions)."""
    cfg = read_history_config()
    if not cfg["enabled"]:
        return False
    os.makedirs(persist_dir, exist_ok=True)
    for (stream, window), tmp_path in zip(PERSIST_STREAMS, (samples_tmp, battery_tmp)):
        prev, cur = persist_segments(persist_dir, stream)
        rotate_segment(prev, cur, window, ref_ms)
        cursors[stream] = flush_new_lines(tmp_path, cur, cursors.get(stream, 0))
    return True


def restore_from_persist(tmp_paths, persist_dir, ref_ms=None):
    """Boot path: seed each empty tmpfs stream from its backup segments
    (filtered to the retention window) and return the flush cursors — the
    newest t already on disk, so the first flush only appends what is new."""
    cursors = {}
    for (stream, window), tmp_path in zip(PERSIST_STREAMS, tmp_paths):
        prev, cur = persist_segments(persist_dir, stream)
        seed_tmp_from_persist(tmp_path, [prev, cur], window, ref_ms)
        cursors[stream] = max_t_in_file(cur) or max_t_in_file(prev)
    return cursors


def main():
    hist = os.environ.get("MUDIMODEM_HIST", "/tmp/mudimodem")
    persist_dir = os.environ.get("MUDIMODEM_HISTORY_PERSIST", HISTORY_PERSIST)
    os.makedirs(hist, exist_ok=True)
    samples_path = os.path.join(hist, "samples.jsonl")
    events_path = os.path.join(hist, "events.jsonl")
    latest_path = os.path.join(hist, "latest.json")
    battery_path = os.path.join(hist, "battery.jsonl")
    battery_latest_path = os.path.join(hist, "battery-latest.json")

    # Seed live tmpfs from eMMC backup when the option is on and this is a
    # fresh boot (empty tmpfs). Cursor starts at the newest t already on disk
    # so the first flush only appends post-seed samples.
    cursors = {"samples": 0, "battery": 0}
    if read_history_config().get("enabled"):
        cursors.update(restore_from_persist((samples_path, battery_path), persist_dir))

    state = {"go": True}
    def stop(*_a):
        state["go"] = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    i = 0
    batt_gate = Gate(BATT_INTERVAL)
    flush_gate = Gate(FLUSH_INTERVAL)
    while state["go"]:
        try:
            # Battery FIRST, and gated on ELAPSED TIME rather than a tick count.
            # A tick is not 10 s: ubus_call has an 8 s timeout and collect_sample
            # makes two of them, so a bad tick can run ~16 s and a tick count
            # would silently stretch the battery interval.
            if batt_gate.due():
                b = read_battery()
                if b is not None:
                    with open(battery_path, "a") as f:
                        f.write(json.dumps(b) + "\n")
                    write_latest(battery_latest_path, b)
                    if ws_attached():
                        ws_publish(WS_BATT_NAME, b)
            s = collect_sample()
            if s is not None:
                with open(samples_path, "a") as f:
                    f.write(json.dumps(s) + "\n")
                write_latest(latest_path, s)
                if ws_attached():
                    ws_publish(WS_NAME, s)
            i += 1
            if i % TRIM_EVERY == 0:
                trim(samples_path, SAMPLE_MAX_AGE, SAMPLE_MAX_LINE)
                trim(battery_path, BATT_MAX_AGE, BATT_MAX_LINE)
            if i % EVENT_TRIM_EVERY == 0:
                # the backend + the watchdog append to this one concurrently
                trim(events_path, SAMPLE_MAX_AGE, 1000, shared=True)
            # Approach #2: batched eMMC flush (config re-read each attempt).
            if flush_gate.due():
                maybe_flush_persist(samples_path, battery_path, persist_dir, cursors)
        except Exception as e:                       # never die out of the loop
            sys.stderr.write("collectd: %s\n" % e)
            sys.stderr.flush()
        # interruptible sleep so SIGTERM stops us within ~0.1 s (procd-friendly)
        end = time.monotonic() + POLL_INTERVAL
        while state["go"] and time.monotonic() < end:
            time.sleep(0.1)

    # Best-effort final flush so a clean stop (procd restart / reboot with UPS)
    # doesn't leave up to FLUSH_INTERVAL of history only in RAM.
    try:
        if read_history_config().get("enabled"):
            maybe_flush_persist(samples_path, battery_path, persist_dir, cursors)
    except Exception as e:
        sys.stderr.write("collectd final flush: %s\n" % e)
        sys.stderr.flush()


if __name__ == "__main__":
    main()
