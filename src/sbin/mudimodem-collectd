#!/usr/bin/python3
# mudimodem-collectd — background modem-history collector for MudiModem (GL 4.10).
#
# Every POLL_INTERVAL it reads GL's cellular ubus for the ACTIVE slot and appends
# one normalized sample (cellular_compat.build_sample: signals[] + PCC aliases)
# to /tmp/mudimodem/samples.jsonl, writes latest.json and publishes it to the
# web UI over GL's own websocket bus (`ubus call gl-session notify
# {name:"mudimodem.collect", data}`; battery samples go out as
# mudimodem.battery), so no page ever polls for live data. gl-session's notify
# is a no-op with no browser attached, so it is called unconditionally.
#
# ⚠️ `cellular.network cell_info` is NOT a cache read on 4.10: its handler
# executes AT+QENG / AT+QCAINFO on the shared AT channel every call. That is
# why the default cadence is 10 s (GL's own signal log polls at 10 s) and
# why nothing else here touches the modem: carrier/identity come from
# `cellular.network info` at a slow cadence, battery from sysfs only.
#
# Live storage is tmpfs (RAM). Optional eMMC backup (Config → keep history
# across reboots) periodically APPENDs new lines to /etc/mudimodem/history/
# and seeds tmpfs from that on boot — off by default.
#
# Stdlib only; shares cellular_compat.py (/usr/lib/mudimodem). Managed by
# procd (/etc/init.d/mudimodem-collectd), respawned on crash.
#
# Env overrides (tests): MUDIMODEM_HIST (dir), MUDIMODEM_POLL (seconds),
# MUDIMODEM_CARRIER_INTERVAL, MUDIMODEM_HISTORY_CFG, MUDIMODEM_HISTORY_PERSIST,
# MUDIMODEM_FLUSH_INTERVAL, MUDIMODEM_NO_WS_PUSH=1 (skip gl-session notify).

import json
import os
import signal
import subprocess
import sys
import time

_HERE = os.path.dirname(os.path.abspath(globals().get("__file__") or sys.argv[0] or "."))
for _d in ("/usr/lib/mudimodem", os.path.join(_HERE, "..", "lib")):
    if os.path.isdir(_d) and _d not in sys.path:
        sys.path.insert(0, _d)
import cellular_compat as cc  # noqa: E402

BUS             = os.environ.get("MUDIMODEM_BUS", "cpu")
POLL_INTERVAL   = float(os.environ.get("MUDIMODEM_POLL", "10"))
CARRIER_INTERVAL = float(os.environ.get("MUDIMODEM_CARRIER_INTERVAL", "60"))
SAMPLE_MAX_AGE  = 24 * 3600 * 1000     # 24 h, in ms
SAMPLE_MAX_LINE = 9000                  # 24h at 10s = 8640; hard backstop above that
TRIM_EVERY      = 12                     # ~2 min at 10 s
EVENT_TRIM_EVERY = 360                   # ~1 h
WS_NAME         = "mudimodem.collect"    # global_sockets names the page subscribes to
WS_BATT_NAME    = "mudimodem.battery"
WS_PUSH         = os.environ.get("MUDIMODEM_NO_WS_PUSH") != "1"

# ---- battery (issue #1) ---------------------------------------------------
# Sampled from sysfs only: no ubus, no AT, nothing that can contend with the
# modem channel. Slower cadence than the modem because the values move slowly —
# SoC is an integer % that changes every ~60-90 s while charging.
BATT_INTERVAL   = float(os.environ.get("MUDIMODEM_BATT_INTERVAL", "20"))
BATT_MAX_AGE    = 24 * 3600 * 1000      # 24 h, in ms
BATT_MAX_LINE   = 5200                  # 24h at 20s = 4320; backstop above that
BATT_SYSFS      = os.environ.get("MUDIMODEM_BATT_SYSFS", "/sys/class/power_supply")
# glbattlimit's own runtime state. Both files are created by its watcher and
# removed when it exits (including on unplug), so their presence — plus a
# liveness check on the pid, exactly as `glbattlimit status` does — is the
# authoritative "the limiter is running" signal. Recorded PER SAMPLE because it
# is history: a settings change mid-window must not retroactively relabel the
# samples that came before it.
BATT_LIMIT_PIDF = os.environ.get("MUDIMODEM_BATTLIMIT_PIDF", "/tmp/glbattlimit.pid")
BATT_LIMIT_LIMF = os.environ.get("MUDIMODEM_BATTLIMIT_LIMF", "/tmp/glbattlimit.limit")

# ---- optional eMMC backup (approach #2) -----------------------------------
# Live path is always tmpfs. When enabled, every FLUSH_INTERVAL we APPEND only
# the new lines to /etc/mudimodem/history/ (overlay/eMMC). On startup we seed
# empty tmpfs from that backup so charts survive reboot. Off by default —
# see /etc/mudimodem/history.json { "enabled": false }.
HISTORY_CFG = os.environ.get("MUDIMODEM_HISTORY_CFG",
                             "/etc/mudimodem/history.json")
HISTORY_PERSIST = os.environ.get("MUDIMODEM_HISTORY_PERSIST",
                                 "/etc/mudimodem/history")
FLUSH_INTERVAL = float(os.environ.get("MUDIMODEM_FLUSH_INTERVAL", "600"))  # 10 min


def now_ms():
    return int(time.time() * 1000)


def write_latest(path, sample):
    """Atomically write the newest sample so a just-connected consumer (or a
    debugger) can read current state without waiting for the next tick."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(json.dumps(sample))
    os.replace(tmp, path)


def ubus_call(obj, method, args=None):
    """Return the parsed ubus result dict, or None on any failure."""
    try:
        out = subprocess.run(["ubus", "call", obj, method, json.dumps(args or {})],
                             capture_output=True, timeout=8, text=True)
        if out.returncode != 0 or not out.stdout:
            return None
        return json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def _num(v):
    return cc.normalize_metric(v)


def build_sample(modem, cell_info, networks_info=None, t=None, carrier=None):
    """Pure: one normalized sample (cellular_compat.build_sample) stamped with
    the box clock. None when the active slot can't be resolved."""
    s = cc.build_sample(modem, cell_info, networks_info, t=t, bus=BUS, carrier=carrier)
    if s is not None and s["t"] is None:
        s["t"] = now_ms()
    return s


class CarrierCache:
    """`cellular.network info` is the identity/carrier source (the same call
    GL's ws merge layer uses). It is re-read only every CARRIER_INTERVAL or
    when the active slot changes — never per tick."""

    def __init__(self):
        self.at = 0.0
        self.slot = None
        self.info = None

    def get(self, slot):
        if self.info is None or slot != self.slot or time.time() - self.at >= CARRIER_INTERVAL:
            self.info = ubus_call("cellular.network", "info") or {}
            self.at = time.time()
            self.slot = slot
        return self.info


_carrier = CarrierCache()


def collect_sample():
    """The 4.10 read path: modem status (active slot, GL's no-arg modems[] form),
    then ONE cell_info {bus,slot} (the AT-backed call — exactly once per tick),
    carrier from the slow identity cache."""
    modem = ubus_call("cellular.modem", "status")
    slot = cc.active_slot(modem, BUS)
    if slot is None:
        return None
    cell = ubus_call("cellular.network", "cell_info", {"bus": BUS, "slot": slot})
    return build_sample(modem, cell, _carrier.get(slot))


_ws_fail = {"n": 0, "last_log": 0.0}
WS_FAIL_LOG_EVERY_S = 60


def _ws_failure(detail):
    """Record one failed push and say so on stderr (procd forwards it to logd):
    the first failure immediately, then at most once a minute — a dead
    gl-session must be visible in logread without flooding it every 10 s."""
    _ws_fail["n"] += 1
    now = time.time()
    if _ws_fail["n"] == 1 or now - _ws_fail["last_log"] >= WS_FAIL_LOG_EVERY_S:
        _ws_fail["last_log"] = now
        sys.stderr.write("collectd: gl-session notify failed (%d so far): %s\n"
                         % (_ws_fail["n"], detail))
        sys.stderr.flush()


def ws_publish(name, sample):
    """Push one frame to every web client subscribed to `name` via GL's own push
    bus — the same mechanism cellular_manager uses for cellular.modems_status.
    With no browser attached gl-session's handler simply has no client to send
    to and still returns status 0 (gl-ngx-session.lua `notify`), so a non-zero
    exit is ALWAYS a fault (gl-session not registered, ubusd down, message
    rejected) — logged, never swallowed. True iff the frame was accepted."""
    if not WS_PUSH:
        return False
    try:
        out = subprocess.run(["ubus", "call", "gl-session", "notify",
                              json.dumps({"name": name, "data": sample})],
                             capture_output=True, timeout=5, text=True)
    except (OSError, subprocess.TimeoutExpired) as e:
        _ws_failure(str(e))
        return False
    if out.returncode != 0:
        _ws_failure("rc=%d %s" % (out.returncode,
                                  ((out.stderr or out.stdout or "").strip())[:200]))
        return False
    if _ws_fail["n"]:
        sys.stderr.write("collectd: gl-session notify recovered after %d failure(s)\n" % _ws_fail["n"])
        sys.stderr.flush()
        _ws_fail["n"] = 0
    return True


def _readfile(path):
    """Read one small text file, stripped. None if absent or unreadable."""
    try:
        with open(path) as f:
            return f.read().strip()
    except (OSError, ValueError):
        return None


def _sysfs(root, rel):
    """Read one sysfs node, stripped. None if it is absent or unreadable."""
    return _readfile(os.path.join(root, rel))


def read_limiter(pidf=None, limf=None):
    """Is glbattlimit's watcher running, and at what gauge target?

    Returns (running: int 0|1, target_gauge: int|None).

    ⚠️ WHY THIS EXISTS. The charger reports `status=Full` + `charge_type=Trickle`
    BOTH when the cell is genuinely full and when glbattlimit is holding charge
    off — because the way it holds charge off is to write the buck's `vreg`
    below the current cell voltage (glbattlimit `gate_on`), which is precisely
    the condition a charger reports as "charge complete". So `status` CANNOT
    tell the two apart, and neither can `current_now == 0`. The limiter's own
    pid/limit files can, and they are the same signal `glbattlimit status`
    prints (and the backend's get_battlimit parses), so the chart and the
    charge-limit card cannot contradict each other.
    """
    pidf = BATT_LIMIT_PIDF if pidf is None else pidf
    limf = BATT_LIMIT_LIMF if limf is None else limf
    running = 0
    raw = _readfile(pidf)
    try:
        pid = int(raw)
    except (TypeError, ValueError):
        pid = 0
    if pid > 0:
        try:
            os.kill(pid, 0)          # signal 0 = liveness probe, like `kill -0`
            running = 1
        except PermissionError:
            running = 1              # alive, just not ours to signal
        except OSError:
            running = 0              # stale pidfile: watcher was killed hard
    target = _num(_readfile(limf))
    return running, (None if target is None else int(target))


def read_battery(root=None, t=None, pidf=None, limf=None):
    """One battery sample from /sys/class/power_supply, or None if the fuel
    gauge is unreadable (i.e. not this hardware) — in which case we write no
    battery file at all rather than a file full of nulls.

    ⚠️ UNITS ARE PER-NODE. There is no blanket rule here:
      voltage_now  uV        -> mV
      temp         deci-C    -> C
      current_now  mA ALREADY, signed. DO NOT divide by 1000.
                   +charging / -discharging / 0 = charging blocked.
                   The Linux power_supply class normally uses uA, so mA looks
                   wrong; glbattlimit line 166 documents it and the physics
                   agree (-363 at 4.0 V = 1.45 W; as uA it would be 1.5 mW).
    `cap` is stored as the RAW GAUGE %, never converted to GL's "GUI" scale:
    that conversion is a provisional linear fit, and storing the raw reading
    keeps retained history valid if the fit is ever corrected.

    `lim` / `lim_gauge` carry glbattlimit's state at the moment of the sample
    (see read_limiter) — the only thing that distinguishes "the limiter is
    holding charge off" from "the battery is full", since the charger reports
    Full/Trickle for both.
    """
    root = BATT_SYSFS if root is None else root
    bat, chg = "cw221X-bat", "charger"
    cap = _num(_sysfs(root, bat + "/capacity"))
    if cap is None:
        return None                              # no gauge => not this hardware
    volt = _num(_sysfs(root, bat + "/voltage_now"))
    temp = _num(_sysfs(root, bat + "/temp"))
    lim, lim_gauge = read_limiter(pidf, limf)
    return {
        "t": now_ms() if t is None else t,
        "cap": cap,
        "volt": None if volt is None else int(volt // 1000),
        "cur": _num(_sysfs(root, bat + "/current_now")),
        "temp": None if temp is None else round(temp / 10.0, 1),
        "online": int(_num(_sysfs(root, chg + "/online")) or 0),
        "status": _sysfs(root, chg + "/status") or "",
        "ctype": _sysfs(root, chg + "/charge_type") or "",
        "cycles": _num(_sysfs(root, bat + "/cycle_count")),
        "health": _sysfs(root, bat + "/health") or "",
        "lim": lim,
        "lim_gauge": lim_gauge,
    }


def trim(path, max_age_ms, max_lines, ref_ms=None):
    """Rewrite path keeping only lines newer than max_age and at most max_lines,
    atomically. Skips malformed lines. No-op if the file is absent."""
    try:
        with open(path) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return
    cutoff = (now_ms() if ref_ms is None else ref_ms) - max_age_ms
    kept = []
    for ln in lines:
        ln = ln.strip()
        if not ln:
            continue
        try:
            obj = json.loads(ln)
        except ValueError:
            continue
        if obj.get("t", 0) >= cutoff:
            kept.append(ln)
    if len(kept) > max_lines:
        kept = kept[-max_lines:]
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(kept) + ("\n" if kept else ""))
    os.replace(tmp, path)


# ---- eMMC history backup helpers (pure; unit-tested) ----------------------

def read_history_config(path=None):
    """Return {enabled: bool}. Missing/malformed file → disabled (safe default)."""
    path = HISTORY_CFG if path is None else path
    out = {"enabled": False}
    try:
        with open(path) as f:
            obj = json.loads(f.read() or "{}")
    except (OSError, ValueError, TypeError):
        return out
    if isinstance(obj, dict) and obj.get("enabled") is True:
        out["enabled"] = True
    return out


def max_t_in_file(path):
    """Largest sample `t` in a jsonl file, or 0 if absent/empty."""
    max_t = 0
    try:
        with open(path) as f:
            for ln in f:
                ln = ln.strip()
                if not ln:
                    continue
                try:
                    t = json.loads(ln).get("t", 0)
                except ValueError:
                    continue
                if isinstance(t, (int, float)) and t > max_t:
                    max_t = int(t)
    except FileNotFoundError:
        pass
    return max_t


def seed_tmp_from_persist(tmp_path, persist_path):
    """If tmpfs file is empty/missing and persist has data, copy persist → tmp.
    Returns True if a seed happened. Does not overwrite non-empty tmpfs (this
    boot may already have samples; a full merge is unnecessary and racy)."""
    try:
        if os.path.exists(tmp_path) and os.path.getsize(tmp_path) > 0:
            return False
    except OSError:
        pass
    try:
        if not os.path.exists(persist_path) or os.path.getsize(persist_path) == 0:
            return False
    except OSError:
        return False
    try:
        with open(persist_path) as src:
            body = src.read()
        tmp = tmp_path + ".seed"
        os.makedirs(os.path.dirname(tmp_path) or ".", exist_ok=True)
        with open(tmp, "w") as dst:
            dst.write(body)
        os.replace(tmp, tmp_path)
        return True
    except OSError:
        return False


def flush_new_lines(tmp_path, persist_path, since_t):
    """Append jsonl lines from tmp_path with t > since_t onto persist_path.
    Returns the new since_t (max t flushed, or unchanged if nothing new).
    APPEND-ONLY — never rewrites the whole persist file here (trim does that)."""
    new_since = since_t
    try:
        with open(tmp_path) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return since_t
    out = []
    for ln in lines:
        raw = ln.strip()
        if not raw:
            continue
        try:
            obj = json.loads(raw)
        except ValueError:
            continue
        t = obj.get("t", 0)
        if not isinstance(t, (int, float)):
            continue
        t = int(t)
        if t > since_t:
            out.append(raw)
            if t > new_since:
                new_since = t
    if not out:
        return since_t
    os.makedirs(os.path.dirname(persist_path) or ".", exist_ok=True)
    with open(persist_path, "a") as f:
        f.write("\n".join(out) + "\n")
    return new_since


def maybe_flush_persist(samples_tmp, battery_tmp, persist_dir, cursors):
    """If config enabled, append new tmpfs lines to eMMC and trim backups.
    `cursors` is a mutable dict {samples, battery} of last-flushed t.
    Returns updated enabled flag (so the caller can log transitions)."""
    cfg = read_history_config()
    if not cfg["enabled"]:
        return False
    os.makedirs(persist_dir, exist_ok=True)
    p_samples = os.path.join(persist_dir, "samples.jsonl")
    p_battery = os.path.join(persist_dir, "battery.jsonl")
    cursors["samples"] = flush_new_lines(
        samples_tmp, p_samples, cursors.get("samples", 0))
    cursors["battery"] = flush_new_lines(
        battery_tmp, p_battery, cursors.get("battery", 0))
    # Trim backups to the same 24 h window as live history.
    trim(p_samples, SAMPLE_MAX_AGE, SAMPLE_MAX_LINE)
    trim(p_battery, BATT_MAX_AGE, BATT_MAX_LINE)
    # After trim the max t is unchanged; cursor stays valid.
    return True


def main():
    hist = os.environ.get("MUDIMODEM_HIST", "/tmp/mudimodem")
    persist_dir = os.environ.get("MUDIMODEM_HISTORY_PERSIST", HISTORY_PERSIST)
    os.makedirs(hist, exist_ok=True)
    samples_path = os.path.join(hist, "samples.jsonl")
    events_path = os.path.join(hist, "events.jsonl")
    latest_path = os.path.join(hist, "latest.json")
    battery_path = os.path.join(hist, "battery.jsonl")
    battery_latest_path = os.path.join(hist, "battery-latest.json")

    # Seed live tmpfs from eMMC backup when the option is on and this is a
    # fresh boot (empty tmpfs). Cursor starts at the newest t already on disk
    # so the first flush only appends post-seed samples.
    cursors = {"samples": 0, "battery": 0}
    if read_history_config().get("enabled"):
        seed_tmp_from_persist(samples_path, os.path.join(persist_dir, "samples.jsonl"))
        seed_tmp_from_persist(battery_path, os.path.join(persist_dir, "battery.jsonl"))
        cursors["samples"] = max_t_in_file(os.path.join(persist_dir, "samples.jsonl"))
        cursors["battery"] = max_t_in_file(os.path.join(persist_dir, "battery.jsonl"))

    state = {"go": True}
    def stop(*_a):
        state["go"] = False
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    i = 0
    last_batt = 0.0
    last_flush = 0.0
    while state["go"]:
        try:
            # Battery FIRST, and gated on ELAPSED TIME rather than a tick count.
            # A tick is not 10 s: ubus_call has an 8 s timeout and collect_sample
            # makes two of them, so a bad tick can run ~16 s and a tick count
            # would silently stretch the battery interval.
            if time.time() - last_batt >= BATT_INTERVAL:
                last_batt = time.time()
                b = read_battery()
                if b is not None:
                    with open(battery_path, "a") as f:
                        f.write(json.dumps(b) + "\n")
                    write_latest(battery_latest_path, b)
                    ws_publish(WS_BATT_NAME, b)
            s = collect_sample()
            if s is not None:
                with open(samples_path, "a") as f:
                    f.write(json.dumps(s) + "\n")
                write_latest(latest_path, s)
                ws_publish(WS_NAME, s)
            i += 1
            if i % TRIM_EVERY == 0:
                trim(samples_path, SAMPLE_MAX_AGE, SAMPLE_MAX_LINE)
                trim(battery_path, BATT_MAX_AGE, BATT_MAX_LINE)
            if i % EVENT_TRIM_EVERY == 0:
                trim(events_path, SAMPLE_MAX_AGE, 1000)
            # Approach #2: batched eMMC flush (config re-read each attempt).
            if time.time() - last_flush >= FLUSH_INTERVAL:
                last_flush = time.time()
                maybe_flush_persist(samples_path, battery_path, persist_dir, cursors)
        except Exception as e:                       # never die out of the loop
            sys.stderr.write("collectd: %s\n" % e)
            sys.stderr.flush()
        # interruptible sleep so SIGTERM stops us within ~0.1 s (procd-friendly)
        end = time.time() + POLL_INTERVAL
        while state["go"] and time.time() < end:
            time.sleep(0.1)

    # Best-effort final flush so a clean stop (procd restart / reboot with UPS)
    # doesn't leave up to FLUSH_INTERVAL of history only in RAM.
    try:
        if read_history_config().get("enabled"):
            maybe_flush_persist(samples_path, battery_path, persist_dir, cursors)
    except Exception as e:
        sys.stderr.write("collectd final flush: %s\n" % e)
        sys.stderr.flush()


if __name__ == "__main__":
    main()
