#!/usr/bin/eco
-- mudimodemd — MudiModem's daemon on GL 4.10's own lua-eco (/usr/bin/eco, Lua 5.4).
--
-- R3 plan (docs/architecture.md §6): ① the collector — RF + battery sampling, the history files,
-- the eMMC backup and the live pushes — with the contract of the Python collector it replaces
-- (src/lib/mudimodemd/collector.lua); ③ the AT console's queue, so a console command no longer
-- holds GL's one nginx worker (the plugin forwards over oui.ubus, a non-blocking cosocket).
-- Jobs and the change transaction come next, on the same ubus object `mudimodem` (server-side
-- only: oui's /rpc dispatches to Lua plugins and glc, never to ubus).
--
--   ubus call mudimodem health      counters, last error, whether a browser is attached
--   ubus call mudimodem at_start {cmd, timeout}   queue an AT sequence (mudimodemd/atq.lua)
--   ubus call mudimodem at_wait {id, wait}        its result, waiting up to `wait` s (<= 25)
--
-- Managed by procd (/etc/init.d/mudimodem-collectd), respawned on exit. Env overrides for tests:
-- MUDIMODEM_LIB (module dir), MUDIMODEM_UBUS_SOCK, MUDIMODEM_UBUS_TIMEOUT (s, default 8), and the
-- collector's MUDIMODEM_* knobs.
local LIB = os.getenv("MUDIMODEM_LIB") or "/usr/lib/mudimodem"
package.path = LIB .. "/?.lua;" .. package.path

local cjson = require "cjson"
local ubus = require "eco.ubus"
local sys = require "eco.sys"
local cc = require "cellular_compat"
cc.init(cjson.null)
local collector = require "mudimodemd.collector"
local atq = require "mudimodemd.atq"

local function log(msg) io.stderr:write("mudimodemd: ", msg, "\n"); io.stderr:flush() end

local function version()
  local f = io.open("/etc/mudimodem/version.json", "r")
  if not f then return "" end
  local ok, v = pcall(cjson.decode, f:read("*a") or ""); f:close()
  return ok and type(v) == "table" and type(v.version) == "string" and v.version or ""
end

local conn, err = ubus.connect(os.getenv("MUDIMODEM_UBUS_SOCK"))
if not conn then log("ubus connect failed: " .. tostring(err)); os.exit(1) end
-- per call, as the Python collector's subprocess timeout (a wedged modem stack must not stall a tick)
conn:settimeout(tonumber(os.getenv("MUDIMODEM_UBUS_TIMEOUT") or "") or 8)
-- ubusd restarting would otherwise leave us alive and deaf: every call answers "not found" for
-- good and our object is gone. auto_reconnect re-dials and re-registers it (test/collectd-emu).
conn:auto_reconnect()

-- The collector is optional: with the Python collector pinned (/etc/mudimodem/collector), the
-- init script runs us with MUDIMODEMD_COLLECTOR=0 for the AT queue alone.
local c = os.getenv("MUDIMODEMD_COLLECTOR") ~= "0" and collector.new(conn, collector.config(), log) or nil

-- AT requests get their own connection: its timeout is set per step, and a 65 s AT wait must
-- not stretch the collector's 8 s calls.
local atconn = assert(ubus.connect(os.getenv("MUDIMODEM_UBUS_SOCK")))
atconn:auto_reconnect()
local q = atq.new(conn, atconn, { bus = os.getenv("MUDIMODEM_BUS") or "cpu", log = log,
                                  tool = os.getenv("MUDIMODEM_AT_TOOL"), python = os.getenv("MUDIMODEM_PYTHON") })

-- eco.ubus does not enforce these policies (handlers get the request as sent): they document
-- the signature for `ubus -v list mudimodem`; at.lua / atq.lua validate every field.
local ok, aerr = conn:add("mudimodem", {
  health = { function(req)
    local h = { engine = "eco", version = version(), pid = sys.getpid(), now = os.time(), collector = c ~= nil }
    for k, v in pairs(c and c.state or {}) do h[k] = v end
    for k, v in pairs(q.stats) do h[k] = v end
    conn:reply(req, h)
  end, {} },
  at_start = { function(req, msg)
    msg = type(msg) == "table" and msg or {}
    conn:reply(req, q.start(msg.cmd, msg.timeout))
  end, { cmd = ubus.STRING, timeout = ubus.INT32 } },
  at_wait = { function(req, msg)
    msg = type(msg) == "table" and msg or {}
    conn:reply(req, q.wait(msg.id, msg.wait))
  end, { id = ubus.INT32, wait = ubus.INT32 } },
})
if not ok then
  -- another instance owns the object: two samplers would double the AT-backed cell_info
  log("cannot register ubus object mudimodem (" .. tostring(aerr) .. "): already running?")
  os.exit(1)
end

local function stop()
  if c then c.stop() end
  eco.unloop()
end
sys.signal(sys.SIGTERM, stop)
sys.signal(sys.SIGINT, stop)

if c then c.start() end
