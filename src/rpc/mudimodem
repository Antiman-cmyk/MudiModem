-- MudiModem RPC backend (GL firmware 4.10).  Loaded by oui.rpc via dofile();
-- returns a table of functions.  ubus.call() here may use DOTTED object names
-- (server-side, past the /rpc dot gate).
--
-- Reads: get_bands (three-layer model: module ∩ carrier policy ∩ your config).
-- Writes: set_bands through GL's own per-slot band API (modem.set_band_config,
-- reached via glc) — fail-closed and durable by construction — behind the
-- /usr/sbin/mudimodem-revert confirm-or-revert watchdog. Every write refuses
-- to happen unless the watchdog has ARMED first.
--
-- Firmware shapes are documented in docs/cellular-api-4.10.md.
--
-- ACL: admin session is aclgroup "root" => always allowed (oui/rpc.lua:87). No
-- ACL file needed; do NOT expose any no-auth method.
--
-- The code is split by concern under /usr/lib/mudimodem/rpc/ (src/lib/rpc/ in the tree): core.lua
-- holds the shared helpers and returns them; every other part adds its methods to M. Loaded with
-- dofile from our own directory, so GL's package.path is never touched. MUDIMODEM_LIB overrides
-- the directory; run from a checkout (the tests' dofile of src/rpc/mudimodem) it is src/lib.

local function lib_dir()
  local env = os.getenv("MUDIMODEM_LIB")
  if env and env ~= "" then return env end
  local me = debug and debug.getinfo and debug.getinfo(1, "S").source or ""
  local tree = me:match("^@(.-)src/rpc/mudimodem$")   -- "" for a relative dofile from the root
  if tree then return tree .. "src/lib" end
  return "/usr/lib/mudimodem"
end

local RPC = lib_dir() .. "/rpc/"
local M = {}
local C = dofile(RPC .. "core.lua")
for _, part in ipairs({ "bands", "lock", "change", "history", "console", "speedtest", "config" }) do
  dofile(RPC .. part .. ".lua")(M, C)
end

return M
