-- MudiModem RPC backend (GL firmware 4.10).  Loaded by oui.rpc via dofile();
-- returns a table of functions.  ubus.call() here may use DOTTED object names
-- (server-side, past the /rpc dot gate).
--
-- Reads: get_bands (three-layer model: module ∩ carrier policy ∩ your config).
-- Writes: set_bands through GL's own per-slot band API (modem.set_band_config,
-- reached via glc) — fail-closed and durable by construction — behind the
-- /usr/sbin/mudimodem-revert confirm-or-revert watchdog. Every write refuses
-- to happen unless the watchdog has ARMED first.
--
-- Firmware shapes are documented in docs/cellular-api-4.10.md.
--
-- ACL: admin session is aclgroup "root" => always allowed (oui/rpc.lua:87). No
-- ACL file needed; do NOT expose any no-auth method.

local ubus  = require "oui.ubus"
local cjson = require "cjson"

local M = {}

-- Paths (overridable via env for the isolation tests).
local PENDING    = os.getenv("MUDIMODEM_PENDING") or "/etc/mudimodem/pending"
local ARMED      = os.getenv("MUDIMODEM_ARMED")   or "/etc/mudimodem/armed"
local REVERT_BIN = os.getenv("MUDIMODEM_BIN")     or "/usr/sbin/mudimodem-revert"
-- Detached children (watchdog, speed test, self-update) go through this
-- wrapper so they never inherit nginx's listening sockets (see the script).
local DETACH     = os.getenv("MUDIMODEM_DETACH")  or "/usr/lib/mudimodem/mudimodem-detach"
local LATEST     = os.getenv("MUDIMODEM_LATEST")  or "/tmp/mudimodem/latest.json"
local BUS        = "cpu"                      -- the built-in modem's bus
-- History telemetry lives in tmpfs (volatile), separate from the durable /etc
-- pending state. samples.jsonl is written by mudimodem-collectd; events.jsonl by
-- us (user events) + the watchdog (dog events). get_history serves both.
local HIST_DIR   = os.getenv("MUDIMODEM_HIST") or "/tmp/mudimodem"
local SAMPLES    = HIST_DIR .. "/samples.jsonl"
local EVENTS     = HIST_DIR .. "/events.jsonl"
local BATTERY    = HIST_DIR .. "/battery.jsonl"

-- An empty Lua table encodes as {} (object); GL's set_band_config wants []
-- for empty band lists. cjson.empty_array is the sentinel that encodes as [].
-- (Older lua-cjson builds lack the sentinel — the dev box's, not the router's —
-- so fall back to a plain table there rather than emitting a nil field.)
local EMPTY_ARRAY = cjson.empty_array or {}
local function arr(t)
  if type(t) == "table" and #t > 0 then return t end
  return EMPTY_ARRAY
end

-- JSON null decodes to cjson.null, a lightuserdata that is TRUTHY in Lua — a
-- bare `if obj.pci then` passes on "pci": null. Launder every decoded field
-- that gates a decision through nn() first.
local function nullish(v) return v == nil or v == cjson.null end
local function nn(v) if nullish(v) then return nil end return v end

-- Editable RATs: our key <-> the AT param <-> GL's band_list key.
local RATS = {
  { key = "sa",  param = "nr5g_band",     gl = "NR-SA" },
  { key = "nsa", param = "nsa_nr5g_band", gl = "NR-NSA" },
  { key = "lte", param = "lte_band",      gl = "LTE" },
}
-- Network mode: GL's network_mode value (== the modem's mode_pref). Only these
-- three are exposed (GL's own choices). NSA needs an LTE anchor, so it is
-- usable only under AUTO; SA under AUTO/NR5G; LTE under AUTO/LTE.
local MODES = { AUTO = true, NR5G = true, LTE = true }

-- Launch a command detached from this nginx worker (fds closed, own session).
local function spawn_detached(cmd)
  os.execute(DETACH .. " " .. cmd .. " >/dev/null 2>&1 &")
end

-- Call a dotted ubus object, returning (table|nil, err).
--
-- ⚠️ MUST NOT be wrapped in pcall: oui.ubus.call uses an nginx cosocket, which
-- YIELDS while waiting on I/O. This box's Lua cannot yield across a C-call
-- boundary (pcall), so a pcall wrapper makes every call throw
-- "attempt to yield across metamethod/C-call boundary". GL's own plugins call
-- ubus.call bare for exactly this reason. ubus.call already returns (nil, err)
-- on ubus-level failure without throwing, so no pcall is needed.
local function ucall(object, method, args)
  return ubus.call(object, method, args or {})
end

-- Run a raw AT command at a given sub_id, return the payload string (or nil).
local function at(cmd, sub_id)
  local res = ucall("modem.CPU.AT", "get_result_AT",
                    { cmd = cmd, timeout = 8, sub_id = sub_id })
  if not res or not res.data then return nil end
  return res.data
end

-- Parse a colon list "2:5:71" -> { 2, 5, 71 } (numbers, order preserved).
-- Band 0 does not exist in any RAT; the modem uses a lone "0" to mean EMPTY
-- (e.g. nsa_nr5g_band,0 when SA-only). So drop zeros -> {} means "none".
local function parse_list(s)
  local out = {}
  if not s then return out end
  for n in s:gmatch("(%d+)") do
    local v = tonumber(n)
    if v and v > 0 then out[#out + 1] = v end
  end
  return out
end

-- From a QNWPREFCFG multi-line blob, pull one key's list:
--   +QNWPREFCFG: "nr5g_band",25:41:48:66:71:77
local function pref_line(blob, key)
  if not blob then return nil end
  -- match  "<key>",<digits-with-colons>   (value may be empty)
  local val = blob:match('"' .. key .. '",([%d:]*)')
  return parse_list(val)
end

-- Same, but the raw value string, verbatim (for writing back on revert). "" if absent.
local function pref_raw(blob, key)
  if not blob then return "" end
  return blob:match('"' .. key .. '",([%d:]*)') or ""
end

local function file_exists(p)
  local f = io.open(p, "r")
  if f then f:close(); return true end
  return false
end

-- Read one key=value out of the pending file.
local function pending_get(key)
  if not file_exists(PENDING) then return nil end
  for line in io.lines(PENDING) do
    local k, v = line:match("^([%w_]+)=(.*)$")
    if k == key then
      local q = v:match("^'(.*)'$")           -- JSON values are single-quoted for sh
      return q or v
    end
  end
  return nil
end

-- The collector's newest sample (cellular_compat schema) when it is fresh,
-- else nil. Lets get_lock skip its own QENG read: the collector already paid
-- for that AT round-trip within the last few seconds.
local function read_latest(max_age_s)
  local f = io.open(LATEST, "r")
  if not f then return nil end
  local body = f:read("*a") or ""
  f:close()
  local ok, obj = pcall(cjson.decode, body)          -- pure C decode; cannot yield
  if not ok or type(obj) ~= "table" or type(obj.t) ~= "number" then return nil end
  if os.time() - obj.t / 1000 > (max_age_s or 30) then return nil end
  return obj
end

-- The built-in modem's object out of `cellular.modem status/info` called WITHOUT
-- arguments — GL's canonical form, which its own consumers parse as modems[]
-- (lib/functions/modem.sh get_current_sim_slot, websocket/cellular.lua,
-- internet.js). No other shape is accepted.
local function pick_modem(payload)
  local mods = type(payload) == "table" and payload.modems or nil
  if type(mods) ~= "table" then return nil end
  for _, m in ipairs(mods) do
    if type(m) == "table" and (m.bus == BUS or m.type == 0) then return m end
  end
  return mods[1]
end

-- sub_id resolution costs 1-3 QSPN round-trips; the slot<->sub_id mapping is
-- stable while the active SIM stays the same, so remember it per worker
-- (keyed by slot + home PLMN) for a while.
local SUBID_TTL = 300
local subid_cache = { key = nil, sub_id = nil, plmn = nil, at = 0 }

-- Append one user/watchdog event to the shared telemetry log (spec §4.1). Net
-- (handover/failover) events are NOT written here — the page derives those from
-- the sample stream. A single O_APPEND JSON line < PIPE_BUF is atomic, so the
-- multiple appenders (us + the watchdog) don't corrupt each other.
local function append_event(kind, label, detail)
  os.execute("mkdir -p " .. HIST_DIR .. " 2>/dev/null")
  local ev = { t = os.time() * 1000, kind = kind, label = label, detail = detail or "" }
  local f = io.open(EVENTS, "a")
  if f then f:write(cjson.encode(ev) .. "\n"); f:close() end
  -- Same push bus the collector uses: the Tracking timeline gets the event now
  -- instead of at its next history fetch. Bare ucall — never pcall a cosocket.
  ucall("gl-session", "notify", { name = "mudimodem.event", data = ev })
end

-- Extract the RPLMN (last quoted field) from a QSPN response:
--   +QSPN: "T-Mobile","T-Mobile","",0,"310260"
local function qspn_plmn(blob)
  if not blob then return nil end
  local last
  for q in blob:gmatch('"([^"]*)"') do last = q end   -- last quoted token
  return last                                          -- "310260" or nil
end

-- Resolve the sub_id that actually talks to the ACTIVE subscription.
-- sub_id=0 is unstable (CLAUDE.md §6), so we MATCH by PLMN rather than assume a
-- slot->sub_id mapping.  Returns (sub_id, operator_plmn, matched_bool).
local function resolve_sub_id(want_plmn)
  for _, sid in ipairs({ 1, 0, 2 }) do            -- prefer 1 (never lead with 0)
    local plmn = qspn_plmn(at("AT+QSPN", sid))
    if plmn and plmn ~= "" then
      if not want_plmn or plmn == want_plmn then
        return sid, plmn, (want_plmn ~= nil)
      end
    end
  end
  return 1, nil, false                            -- fallback: sub_id 1, flagged
end

-- Resolve the active subscription end-to-end: find the serving slot's PLMN from
-- ubus, then the sub_id whose QSPN matches it. Returns (sub_id, plmn, matched, slot).
-- ⚠️ `slot` is nil when GL has no active slot (no SIM, modem resetting): every
-- caller must REFUSE to write in that case — never fall back to slot 1, which
-- would mis-target SIM2/eSIM.
-- GL's active slot (current_sim_slot of the built-in modem), nil when none.
-- One ubus read, no AT — enough for every slot-addressed GL call.
local function active_slot()
  local st = pick_modem(ucall("cellular.modem", "status", {}))
  return st and tonumber(st.current_sim_slot) or nil
end

local function resolve_active()
  local want_plmn
  local slot = active_slot()
  local sims = ucall("cellular.sim", "info", {})
  for _, s in ipairs((sims and sims.sims) or {}) do
    if slot and tonumber(s.slot) == slot and s.mcc and s.mnc then
      want_plmn = tostring(s.mcc) .. tostring(s.mnc)
    end
  end
  local key = tostring(slot) .. ":" .. tostring(want_plmn)
  if subid_cache.key == key and os.time() - subid_cache.at < SUBID_TTL then
    return subid_cache.sub_id, subid_cache.plmn, true, slot
  end
  local sub_id, plmn, matched = resolve_sub_id(want_plmn)
  -- Cache only a PLMN-matched answer, and never sub_id 0: it is documented to
  -- answer for different subscriptions minutes apart (CLAUDE.md §6), so it
  -- must be re-verified by QSPN on every call rather than pinned for 5 min.
  if matched and sub_id ~= 0 then
    subid_cache = { key = key, sub_id = sub_id, plmn = plmn, at = os.time() }
  end
  return sub_id, plmn, matched, slot
end

-- Call one of GL's C rpc plugins (modem.so) exactly as oui.rpc's glc_call does
-- (reference/oui-lib-rpc.lua:126): nginx-internal POST to /cgi-bin/glc, response
-- body is "<code> <json>". Returns (table|nil, err). NOT pcall-wrapped: capture
-- is a cosocket-style nginx API and must be allowed to yield.
local function glc(object, method, args)
  local res = ngx.location.capture("/cgi-bin/glc", {
    method = ngx.HTTP_POST,
    body = cjson.encode({ object = object, method = method, args = args or {} }),
  })
  if not res or res.status ~= 200 then
    return nil, "glc http " .. tostring(res and res.status)
  end
  local code = tonumber(res.body:match("(-?%d+)"))
  if code ~= 0 then return nil, code end                 -- GL error code (e.g. 20002044)
  local msg = res.body:match("%d+ (.*)") or ""
  local ok, obj = pcall(cjson.decode, msg)               -- decode can't yield; pcall fine
  if not ok or type(obj) ~= "table" then return nil, "glc bad json" end
  return obj
end

-- GL 4.10's per-slot band config (modem.get_band_config {bus,slot}):
--   { band_enable, network_mode: "AUTO"|"NR5G"|"LTE", band_list?: {LTE,NR-SA,NR-NSA} }
-- Normalized to { enable, mode, mode_raw, LTE, nsa, sa } (band_list only present
-- when filtering is enabled; absent => every supported band). band_enable is a
-- JSON boolean in GL's own C code (libcm_modem.so get_band_config emits
-- json_true/json_false), so the strict test is right.
--
-- `mode` is the tri-state the page edits; `mode_raw` is GL's stored string
-- verbatim. They differ only if GL ever stores something outside the enum —
-- a colon combo such as the mode_pref=LTE:NR5G GL's own 4G tower lock leaves
-- behind (reference/quectel-at-reference.md §6a). A band-only apply and the
-- revert snapshot pass mode_raw through untouched, so an unrecognised mode
-- is never silently rewritten to AUTO; get_bands flags it (meta.mode_known).
local function band_cfg_get(slot)
  local raw, err = glc("modem", "get_band_config", { bus = BUS, slot = slot })
  if not raw then return nil, err end
  local bl = raw.band_list or {}
  local mode_raw = raw.network_mode
  if type(mode_raw) ~= "string" or mode_raw == "" then mode_raw = nil end
  return {
    enable   = raw.band_enable == true,
    mode     = MODES[mode_raw] and mode_raw or "AUTO",
    mode_raw = mode_raw,
    LTE = bl.LTE or {}, nsa = bl["NR-NSA"] or {}, sa = bl["NR-SA"] or {},
  }
end

-- The exact payload GL's own UI sends to modem.set_band_config: nothing more
-- (no band_filter_mode), lists as JSON arrays, NR lists emptied under LTE
-- mode (GL's rule). `lists` is { LTE=, nsa=, sa= }; nil lists => filtering off.
local function band_cfg_payload(slot, mode, lists)
  local out = { bus = BUS, slot = slot, band_enable = lists ~= nil, network_mode = mode }
  if lists then
    local nr_ok = (mode ~= "LTE")
    out.band_list = {
      LTE = arr(lists.LTE),
      ["NR-NSA"] = nr_ok and arr(lists.nsa) or EMPTY_ARRAY,
      ["NR-SA"]  = nr_ok and arr(lists.sa)  or EMPTY_ARRAY,
    }
  end
  return out
end

local function band_cfg_set(payload)
  return glc("modem", "set_band_config", payload)
end

-- Clear GL's stored cell lock for one slot (slot-addressed, no sub_id). The
-- stored tower fields ride along with lock=false, as GL's own unlock does, so
-- modem.so sees the record it wrote. The ONE GL-side unlock, used by
-- clear_cell_lock and revert_now alike. Returns (result|nil, err).
local function gl_unlock(slot)
  local gl = glc("modem", "get_cell_tower", { bus = BUS })
  local tower = (gl and gl["slot" .. tostring(slot)]) or {}
  local payload = { bus = BUS, slot = slot, lock = false }
  for k, v in pairs(tower) do if payload[k] == nil then payload[k] = v end end
  return glc("modem", "set_cell_tower", payload)
end

-- Run the watchdog's own restore synchronously (src/sbin/mudimodem-revert
-- restore-now): the ONE implementation of "undo what PENDING describes" on the
-- modem side, shared with the window-end revert so the two can never drift.
-- Returns the JSON object it prints, or nil when it gave no answer.
local function restore_now()
  local f = io.popen(REVERT_BIN .. " restore-now 2>/dev/null")
  if not f then return nil end
  local out = f:read("*a") or ""
  f:close()
  local line = out:match("(%b{})")
  if not line then return nil end
  local ok, obj = pcall(cjson.decode, line)       -- pure C decode; cannot yield
  return (ok and type(obj) == "table") and obj or nil
end

-- AT read with the crossed-reply guard (reference §10): the shared channel can
-- answer with a DIFFERENT command's payload. Retry until the reply carries the
-- expected marker; nil after 3 tries (callers treat nil as "unknown").
local function at_expect(cmd, expect, sub_id)
  for _ = 1, 3 do
    local blob = at(cmd, sub_id)
    if blob and blob:find(expect, 1, true) then return blob end
  end
  return nil
end

-- Numbers after a QNWLOCK tag:  '+QNWLOCK: "common/5g",516,127490,15,71'
local function qnwlock_nums(blob, tag)
  if not blob then return nil end
  local tail = blob:match('%+QNWLOCK: "' .. tag .. '",([%d,%s]*)')
  if not tail then return nil end
  local out = {}
  for n in tail:gmatch("(%d+)") do out[#out + 1] = tonumber(n) end
  return out
end

-- "common/4g": ,0 = unlocked; locked reply is ,<mode>,<freq>,<pci>
-- (field order per GL's own parser in /lib/functions/modem.sh:940-942).
local function parse_qnwlock4(blob)
  local n = qnwlock_nums(blob, "common/4g")
  if not n then return nil end
  if #n <= 1 then return { locked = (n[1] or 0) ~= 0 } end
  return { locked = true, mode = n[1], freq = n[2], pci = n[3] }
end

-- "common/5g": ,0 = unlocked; locked reply is ,<pci>,<freq>,<scs>,<band>
-- (PCI FIRST — reference §6a; parser order per modem.sh:926-929).
local function parse_qnwlock5(blob)
  local n = qnwlock_nums(blob, "common/5g")
  if not n then return nil end
  if #n <= 1 then return { locked = (n[1] or 0) ~= 0 } end
  return { locked = true, pci = n[1], freq = n[2], scs = n[3], band = n[4] }
end

local function parse_savectrl(blob)
  local n = qnwlock_nums(blob, "save_ctrl")
  if not n or #n < 2 then return nil end
  return { raw = n[1] .. "," .. n[2], s4g = n[1], s5g = n[2] }
end

-- Serving cell from QENG.
-- SA (single line, verified on-box — reference §4.1 / §8):
--   +QENG: "servingcell",<state>,"NR5G-SA",<duplex>,<mcc>,<mnc>,<cell_id>,<pci>,
--          <tac>,<arfcn>,<band>,…
-- NSA multi-line (ChiliApple #2 / RG650V-EU EN-DC) — the header carries NO cell
-- fields; LTE and NR ride on their own lines:
--   +QENG: "servingcell",<state>
--   +QENG: "LTE",<is_tdd>,<mcc>,<mnc>,<cell_id>,<pci>,<earfcn>,<band>,…
--   +QENG: "NR5G-NSA",<mcc>,<mnc>,<pci>,<rsrp>,<sinr>,<rsrq>,<arfcn>,<band>,…
-- Prefer SA, then NR5G-NSA, then LTE. Never return the header-only line.
local function qeng_csv(line)
  local f = {}
  for tok in line:gmatch('[^,]+') do
    f[#f + 1] = (tok:gsub('^%s*"?', ''):gsub('"?%s*$', ''))
  end
  return f
end

local function parse_serving(blob)
  if not blob then return nil end
  local sa, nsa, lte
  for line in blob:gmatch('[^\r\n]+') do
    if line:find('%+QENG: "servingcell"') then
      local f = qeng_csv(line)
      -- f[1]='+QENG: servingcell', f[2]=state, f[3]=rat (absent on NSA header)
      local rat = f[3]
      if rat == "NR5G-SA" then
        sa = { rat = rat, cell_id = f[7], pci = tonumber(f[8]),
               arfcn = tonumber(f[10]), band = tonumber(f[11]) }
      elseif rat == "LTE" then
        -- Single-line LTE form (state + rat still on the servingcell line)
        lte = lte or { rat = rat, cell_id = f[7], pci = tonumber(f[8]),
                       arfcn = tonumber(f[9]), band = tonumber(f[10]) }
      end
    elseif line:find('%+QENG: "NR5G%-NSA"') then
      local f = qeng_csv(line)
      -- f[1]=+QENG: NR5G-NSA, f[2]=mcc, f[3]=mnc, f[4]=pci, f[5]=rsrp,
      -- f[6]=sinr, f[7]=rsrq, f[8]=arfcn, f[9]=band
      nsa = { rat = "NR5G-NSA", pci = tonumber(f[4]),
              arfcn = tonumber(f[8]), band = tonumber(f[9]) }
    elseif line:find('%+QENG: "LTE"') then
      local f = qeng_csv(line)
      -- f[1]=+QENG: LTE, f[2]=duplex, f[3]=mcc, f[4]=mnc, f[5]=cell_id,
      -- f[6]=pci, f[7]=earfcn, f[8]=band
      lte = lte or { rat = "LTE", cell_id = f[5], pci = tonumber(f[6]),
                     arfcn = tonumber(f[7]), band = tonumber(f[8]) }
    end
  end
  return sa or nsa or lte
end

-- READ: the three-layer band picture for the active subscription.
-- { supported={LTE,nsa,sa}, config={enable,mode,LTE,nsa,sa},
--   policy={LTE,nsa,sa}, capability={LTE,nsa,sa},
--   meta={bus,slot,plmn,sub_id,plmn_matched,mode,lock} }
-- config+mode: ONE glc read of GL's per-slot store (get_band_config). policy +
-- capability: raw AT (the only place they exist). No AT is spent on config.
-- args.light = 1: config + mode + lock ONLY (GL's store, two glc reads, ZERO
-- AT). The page uses it after a cell-lock action — a GL lock changes the
-- stored network_mode and the tower badge, but policy/capability (the two AT
-- reads) cannot have changed, so refetching the full model would spend 2-3 AT
-- round-trips on the shared channel for nothing.
function M.get_bands(args)
  local light = args and (args.light == 1 or args.light == true or args.light == "1") or false

  -- 1. active slot; the PLMN-matched sub_id is needed only for the AT reads.
  local sub_id, plmn, matched, slot
  if light then
    slot = active_slot()
  else
    sub_id, plmn, matched, slot = resolve_active()
  end
  if not slot then return { error = "no active SIM slot (modem not ready)" } end

  -- 2. config + mode — GL's per-slot store.
  local config, cfg_err = band_cfg_get(slot)
  if not config then
    return { error = "get_band_config failed: " .. tostring(cfg_err) }
  end

  -- Cell/tower lock (GL's store) — the RAT the modem is locked to. The Bands
  -- tab warns/blocks when the mode excludes that RAT.
  local gl = glc("modem", "get_cell_tower", { bus = BUS })
  local tw = gl and gl["slot" .. tostring(slot)] or nil
  local lock = { active = false }
  if tw and tw.cellid and tw.cellid ~= "" then
    lock = { active = true, rat = (tostring(tw.network_type or ""):find("LTE")) and "4g" or "5g",
             pci = tw.pci, freq = tw.freq, band = tw.band }
  end

  local meta = {
    bus = BUS,
    slot = slot,
    mode = config.mode,       -- AUTO | NR5G | LTE — GL's network_mode for this slot
    mode_raw = config.mode_raw,
    -- false => GL stores a mode outside AUTO/NR5G/LTE; the page shows it and
    -- leaves it alone (a band-only apply passes it through verbatim).
    mode_known = (config.mode_raw == nil) or (MODES[config.mode_raw] == true),
    lock = lock,              -- { active, rat, pci, freq, band } — network-type lock
  }
  if light then
    meta.light = true
    return { config = config, meta = meta }
  end

  -- 3. supported (module) — cache read, no AT.
  local supported = { LTE = {}, nsa = {}, sa = {} }
  local modem = pick_modem(ucall("cellular.modem", "info", {}))
  if modem and modem.band then
    supported.LTE = modem.band.LTE or {}
    supported.nsa = modem.band["NR-NSA"] or {}
    supported.sa  = modem.band["NR-SA"] or {}
  end

  -- 4. policy + capability — AT only, at the resolved sub_id.
  meta.plmn = plmn
  meta.sub_id = sub_id
  meta.plmn_matched = matched   -- false => sub_id resolution is a best guess
  local pol_blob = at('AT+QNWPREFCFG="policy_band"', sub_id)
  local cap_blob = at('AT+QNWPREFCFG="ue_capability_band"', sub_id)
  local policy = {
    LTE = pref_line(pol_blob, "lte_band"),
    nsa = pref_line(pol_blob, "nsa_nr5g_band"),
    sa  = pref_line(pol_blob, "nr5g_band"),
  }
  local capability = {
    LTE = pref_line(cap_blob, "lte_band"),
    nsa = pref_line(cap_blob, "nsa_nr5g_band"),
    sa  = pref_line(cap_blob, "nr5g_band"),
  }

  return {
    supported = supported,
    config = config,
    policy = policy,
    capability = capability,
    meta = meta,
  }
end

-- The serving cell out of a fresh collector sample, or nil when the sample
-- cannot answer and the QENG read must. Every field is laundered through nn():
-- a no-service sample is written with "pci": null, and cjson.null is truthy.
-- Under NSA the flattened aliases describe the LTE ANCHOR while rat says
-- NR5G-NSA — a 5G lock built from them would target a non-existent NR cell —
-- so the NR leg is taken from signals[] (the row cellular_compat tags NR5G),
-- exactly what parse_serving returns from a multi-line QENG (`sa or nsa or
-- lte`); with no NR row in the sample we decline and let the AT read answer.
local function serving_from_sample(latest)
  local rat = nn(latest.rat) or nn(latest.mode)
  local cell_id = nn(latest.cell_id) or nn(latest.id)
  if type(rat) == "string" and rat:find("NSA", 1, true) then
    local sigs = type(latest.signals) == "table" and latest.signals or {}
    for _, sg in ipairs(sigs) do
      local r = type(sg) == "table" and nn(sg.rat) or nil
      local pci, arfcn = tonumber(nn(sg and sg.pci)), tonumber(nn(sg and sg.earfcn))
      if type(r) == "string" and r:find("NR5G", 1, true) and pci and arfcn then
        return { rat = rat, cell_id = cell_id, pci = pci, arfcn = arfcn,
                 band = tonumber(nn(sg.band)), source = "collector" }
      end
    end
    return nil
  end
  local pci, arfcn = tonumber(nn(latest.pci)), tonumber(nn(latest.tx_channel))
  if not pci or not arfcn then return nil end
  return { rat = rat, cell_id = cell_id, pci = pci, arfcn = arfcn,
           band = tonumber(nn(latest.band)), source = "collector" }
end

-- READ: cell-lock picture — modem truth (QNWLOCK), GL's store (get_cell_tower),
-- the serving cell (lock target for pin-current), and stale/pending flags.
function M.get_lock(args)
  local sub_id, plmn, matched, slot = resolve_active()
  -- Same rule as every other resolve_active() caller: with no active slot
  -- there is nothing to read FOR — the AT reads would go to the fallback
  -- sub_id and be presented as the active SIM's lock state.
  if not slot then return { error = "no active SIM slot (modem not ready)" } end
  local l4 = parse_qnwlock4(at_expect('AT+QNWLOCK="common/4g"', '"common/4g"', sub_id))
  local l5 = parse_qnwlock5(at_expect('AT+QNWLOCK="common/5g"', '"common/5g"', sub_id))
  local sc = parse_savectrl(at_expect('AT+QNWLOCK="save_ctrl"', '"save_ctrl"', sub_id))
  -- Serving cell: the collector's fresh sample already carries rat/pci/arfcn/
  -- band/cell_id for the active slot (it paid the QENG round-trip); only when
  -- that is stale, null, or lacks the NR leg do we spend our own AT read.
  local serving
  local latest = read_latest(30)
  if latest and tonumber(nn(latest.slot)) == slot then serving = serving_from_sample(latest) end
  if not serving then
    serving = parse_serving(at_expect('AT+QENG="servingcell"', '"servingcell"', sub_id))
  end

  local gl = glc("modem", "get_cell_tower", { bus = BUS })
  local tower = gl and gl["slot" .. tostring(slot)] or nil
  local gl_locked = (tower and tower.cellid and tower.cellid ~= "") and true or false
  local modem_locked = (l4 and l4.locked) or (l5 and l5.locked) or false

  local opcfg = glc("modem", "get_operator_config", { bus = BUS, slot = slot })

  return {
    lock = { l4g = l4, l5g = l5, save_ctrl = sc },
    gl = { locked = gl_locked, tower = tower },
    serving = serving,
    -- GL's store remembers a lock the modem no longer has (a watchdog or
    -- revert_now raw-AT unlock whose GL reconcile failed): derived live, no
    -- marker file — the two stores are the only truth.
    stale = (gl_locked and not modem_locked),
    pending_kind = pending_get("KIND") or (file_exists(PENDING) and "bands" or nil),
    operator_config = opcfg,
    meta = { sub_id = sub_id, slot = slot, plmn = plmn, plmn_matched = matched },
  }
end

-- SCAN: GL's full network scan (AT+QSCAN under the hood). DISRUPTIVE — the
-- modem leaves the serving cell for up to ~10 minutes. The UI gates this
-- behind an explicit warning; never call it as part of a read.
function M.scan_cells(args)
  local _, _, _, slot = resolve_active()
  if not slot then return { error = "no active SIM slot (modem not ready)" } end
  local res, err = glc("modem", "scan_cell_tower", { bus = BUS, slot = slot })
  if not res then return { error = "scan failed: " .. tostring(err) } end
  append_event("user", "Cell scan", "")
  return { towers = arr(res.towers or {}), ts = os.time() * 1000 }
end

-- WRITE: lock to one cell via GL's stack, protected by confirm-or-revert.
-- args = { rat="4g"|"5g", pci, freq, scs?, band?, extra? } — extra is an
-- optional table of passthrough tower fields (cellid, carrier, mcc, mnc, …)
-- from a scan row, forwarded verbatim so GL stores what it scanned.
function M.set_cell_lock(args)
  local rat = args and args.rat
  if rat ~= "4g" and rat ~= "5g" then return { error = "rat must be '4g' or '5g'" } end
  local function int(v)
    local n = tonumber(v)
    if n and n >= 0 and n == math.floor(n) then return n end
  end
  local pci, freq = int(args.pci), int(args.freq)
  if not pci or not freq then return { error = "pci and freq are required integers" } end
  local scs, band = int(args.scs), int(args.band)
  if rat == "5g" and (not scs or not band) then
    return { error = "a 5g lock needs scs and band" }
  end
  if file_exists(PENDING) then
    return { error = "another change is pending; keep or revert it first" }
  end

  local sub_id, _, matched, slot = resolve_active()
  if not slot then return { error = "no active SIM slot (modem not ready)" } end
  -- The PREV snapshot and the watchdog's revert both address `sub_id`: an
  -- unconfirmed one (PLMN unknown — SIM still searching, the §12 status-0
  -- wedge) would snapshot and later "revert" the OTHER subscription while the
  -- real lock stayed in place. Refuse rather than guess.
  if not matched then
    return { error = "could not confirm which subscription answers for the active SIM (sub_id); not locking — retry once the SIM is registered" }
  end

  -- One lock at a time (keeps the revert target = "unlocked", always). Fail
  -- CLOSED: at_expect returns nil when it exhausts its retries (crossed AT
  -- replies under heavy polling, reference §10), and parse_qnwlock4/5 pass
  -- that nil straight through. Treating "couldn't read" the same as
  -- "verified unlocked" would let a write proceed over an undetected real
  -- lock and capture a bogus PREV revert target — so an unreadable state is
  -- refused, distinct from a readable-and-unlocked one.
  local l4 = parse_qnwlock4(at_expect('AT+QNWLOCK="common/4g"', '"common/4g"', sub_id))
  local l5 = parse_qnwlock5(at_expect('AT+QNWLOCK="common/5g"', '"common/5g"', sub_id))
  if not l4 or not l5 then
    return { error = "could not read current lock state; try again" }
  end
  if l4.locked or l5.locked then
    return { error = "a cell lock is already set; unlock first" }
  end

  -- Snapshot the revert target: current save_ctrl + mode prefs (GL's lock
  -- changes mode_pref / nr5g_disable_mode as a side effect — spec §0).
  local sc = parse_savectrl(at_expect('AT+QNWLOCK="save_ctrl"', '"save_ctrl"', sub_id))
  local mblob = at('AT+QNWPREFCFG="mode_pref"', sub_id)
  local pmode = (mblob and mblob:match('"mode_pref",([%w:]+)')) or ""
  local dblob = at('AT+QNWPREFCFG="nr5g_disable_mode"', sub_id)
  local pdis = (dblob and dblob:match('"nr5g_disable_mode",(%d+)')) or ""

  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local f = io.open(PENDING, "w")
  if not f then return { error = "cannot write pending state" } end
  f:write(table.concat({
    "KIND=cell", "SUB_ID=" .. sub_id, "SLOT=" .. tostring(slot), "RAT=" .. rat,
    "PREV_SAVE_CTRL=" .. ((sc and sc.raw) or ""),
    "PREV_mode_pref=" .. pmode,
    "PREV_nr5g_disable_mode=" .. pdis,
  }, "\n") .. "\n")
  f:close()

  -- Arm the watchdog; no arm, no write (same interlock as set_bands).
  os.remove(ARMED)
  spawn_detached(REVERT_BIN .. " watch")
  os.execute("sleep 1")
  if not file_exists(ARMED) then
    os.remove(PENDING)
    return { error = "revert watchdog failed to arm; no change written" }
  end

  -- Write through GL so its store and the modem agree (spec §3).
  local payload = { bus = BUS, slot = slot, lock = true,
                    network_type = (rat == "5g") and "NR5G" or "LTE",
                    pci = pci, freq = freq }
  if rat == "5g" then payload.scs = scs; payload.band = band
  elseif band then payload.band = band end
  if type(args.extra) == "table" then
    for k, v in pairs(args.extra) do
      if payload[k] == nil then payload[k] = v end
    end
  end
  local res, err = glc("modem", "set_cell_tower", payload)
  if not res then
    os.remove(PENDING)          -- nothing was written; stand the watchdog down
    return { error = "GL lock call failed: " .. tostring(err) }
  end

  append_event("user", "Cell lock applied",
    rat .. " pci " .. pci .. " freq " .. freq .. (band and (" band " .. band) or ""))
  return { ok = true, window = 60, sub_id = sub_id,
           applied = { rat = rat, pci = pci, freq = freq, scs = scs, band = band } }
end

-- Unlock (risk-reducing — no revert window). Also the stale-store reconciler.
function M.clear_cell_lock(args)
  local sub_id, _, matched, slot = resolve_active()
  if not slot then return { error = "no active SIM slot (modem not ready)" } end
  local res, err = gl_unlock(slot)
  if not res then return { error = "GL unlock failed: " .. tostring(err) } end
  -- GL clears QNWLOCK but leaves the lock's mode side-effect in place, so a 5G
  -- unlock would strand the modem on 5G-only (a 4G lock forces LTE:NR5G +
  -- nr5g_disable_mode=1). Restore the sane default. AUTO — not the exact pre-lock
  -- mode — because the manual-unlock path has no PREV snapshot: PENDING is
  -- deleted on Keep, and Unlock is disabled while a revert pends. Mirrors panic.
  -- Bare at() only — never pcall a cosocket (CLAUDE.md §8).
  -- The GL unlock above is slot-addressed and needs no sub_id; these AT writes
  -- do. Sent to an unconfirmed sub_id they would reset the OTHER SIM's mode
  -- and leave this one stranded — so they wait for a confirmed one.
  if not matched then
    append_event("user", "Cell lock cleared", "unlocked via GL; mode not reset (sub_id unconfirmed)")
    return { ok = true, mode = nil,
             warning = "unlocked, but the network-mode preference was not reset: the active SIM's subscription could not be confirmed. If the link stays on one RAT, retry Unlock once the SIM is registered, or run `mudimodem-revert panic` over ssh." }
  end
  at('AT+QNWPREFCFG="mode_pref",AUTO', sub_id)
  at('AT+QNWPREFCFG="nr5g_disable_mode",0', sub_id)
  at('AT+QNWLOCK="save_ctrl",0,0', sub_id)
  append_event("user", "Cell lock cleared", "unlocked + mode restored to AUTO")
  return { ok = true, mode = "AUTO" }
end

-- WRITE: band allowlists and/or the network mode, protected by
-- confirm-or-revert. args = { sa={..}, nsa={..}, lte={..}, mode="AUTO"|"NR5G"|"LTE",
-- reset=bool } — each optional. A provided list must be non-empty (an empty
-- allowlist would drop that RAT). Omitted RATs keep their current list, or —
-- when filtering was off — every band the module supports. reset=true ignores
-- the lists and writes GL's true default: filtering OFF + AUTO.
--
-- Single write path, fail-closed by construction: the ONE write is GL's
-- modem.set_band_config, which both applies to the modem and persists in GL's
-- store; a failed call changes nothing, a successful one is already durable,
-- and the watchdog restores the previous get_band_config snapshot verbatim.
-- Returns { ok, window, applied={sa=..,nsa=..,lte=..,mode=..}, sub_id } or { error }.
function M.set_bands(args)
  args = args or {}
  local reset = args.reset == true
  local lists = {}
  local any_list = false
  for _, rat in ipairs(RATS) do
    local sel = args[rat.key]
    if type(sel) == "table" then
      if #sel == 0 then
        return { error = "refusing to write an empty " .. rat.key .. " list (would drop that RAT)" }
      end
      local out = {}
      for _, b in ipairs(sel) do
        local n = tonumber(b)
        if not n or n < 1 or n ~= math.floor(n) then
          return { error = "invalid band value: " .. tostring(b) }
        end
        out[#out + 1] = n
      end
      table.sort(out)
      lists[rat.key] = out
      any_list = true
    end
  end
  local mode = args.mode
  if mode ~= nil and not MODES[mode] then
    return { error = "invalid mode: " .. tostring(mode) }
  end
  if not any_list and not mode and not reset then return { error = "no changes provided" } end

  if file_exists(PENDING) then
    return { error = "another change is pending; keep or revert it first" }
  end

  local sub_id, _, _, slot = resolve_active()
  if not slot then return { error = "no active SIM slot (modem not ready)" } end

  -- Snapshot the revert target: GL's stored config for this slot, verbatim.
  local prev, perr = band_cfg_get(slot)
  if not prev then return { error = "could not read current band config: " .. tostring(perr) } end
  -- GL's stored mode string verbatim (mode_raw) so a band-only apply and the
  -- snapshot never rewrite a mode we did not recognise.
  local prev_mode = prev.mode_raw or prev.mode

  -- Build the new config.
  local payload, applied
  if reset then
    payload = band_cfg_payload(slot, "AUTO", nil)
    applied = { mode = "AUTO", reset = true }
  else
    local new_mode = mode or prev_mode
    -- NR lists cannot take effect under 4G-only: GL empties them in its store
    -- (band_cfg_payload's nr_ok rule), so accepting them would report bands
    -- as applied that GL never received. Refuse. The page never sends them
    -- under LTE (applyBands skips the NR groups) — this is the backstop.
    if new_mode == "LTE" and (lists.sa or lists.nsa) then
      return { error = "5G band lists cannot be applied under 4G-only mode; set the mode to Auto or 5G first" }
    end
    if not prev.enable and not any_list then
      -- Filtering is OFF and only the mode changes: keep it off. Materialising
      -- an allowlist here would silently switch filtering ON with every
      -- module-supported band pinned (policy-blocked ones included).
      payload = band_cfg_payload(slot, new_mode, nil)
      applied = { mode = new_mode }
    else
      -- An omitted RAT keeps its current allowlist. An EMPTY current list is
      -- NOT an allowlist (GL empties the NR lists under LTE mode, and an empty
      -- table is truthy in Lua) — that RAT, like every RAT when filtering was
      -- off, falls back to every band the module supports (= no restriction).
      local supported
      local function supported_for(ck)
        if not supported then
          local modem = pick_modem(ucall("cellular.modem", "info", {}))
          local band = (modem and modem.band) or {}
          supported = { LTE = band.LTE or {}, nsa = band["NR-NSA"] or {}, sa = band["NR-SA"] or {} }
        end
        return supported[ck] or {}
      end
      local final = {}
      for _, rat in ipairs(RATS) do
        local ck = (rat.key == "lte") and "LTE" or rat.key    -- config/supported key
        local cur = prev.enable and prev[ck] or nil
        if lists[rat.key] then final[ck] = lists[rat.key]
        elseif type(cur) == "table" and #cur > 0 then final[ck] = cur
        else final[ck] = supported_for(ck) end
      end
      payload = band_cfg_payload(slot, new_mode, final)
      applied = { mode = new_mode }
      -- Report the lists GL is actually asked to store (what band_cfg_payload
      -- arrays), never the request — the countdown text and the Tracking
      -- event can then never claim a list GL did not receive.
      for _, rat in ipairs(RATS) do
        if lists[rat.key] then
          local ck = (rat.key == "lte") and "LTE" or rat.key
          local parts = {}
          for _, n in ipairs(final[ck]) do parts[#parts + 1] = tostring(n) end
          applied[rat.key] = table.concat(parts, ":")
        end
      end
    end
  end

  -- The snapshot GL will be asked to restore: its own get_band_config answer,
  -- re-keyed to the set_band_config shape (only the fields GL's UI sends),
  -- with the mode string verbatim.
  local prev_payload = band_cfg_payload(slot, prev_mode,
    prev.enable and { LTE = prev.LTE, nsa = prev.nsa, sa = prev.sa } or nil)

  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local f = io.open(PENDING, "w")
  if not f then return { error = "cannot write pending state" } end
  f:write(table.concat({
    "KIND=bands", "SUB_ID=" .. sub_id, "SLOT=" .. tostring(slot),
    "PREV_BAND_CONFIG='" .. cjson.encode(prev_payload) .. "'",
    "APPLIED_BAND_CONFIG='" .. cjson.encode(payload) .. "'",
  }, "\n") .. "\n")
  f:close()

  -- Arm the watchdog, and CONFIRM it is live before the write. No net, no write.
  os.remove(ARMED)
  spawn_detached(REVERT_BIN .. " watch")
  os.execute("sleep 1")
  if not file_exists(ARMED) then
    os.remove(PENDING)
    return { error = "revert watchdog failed to arm; no change written" }
  end

  -- The one write. Fail CLOSED: on error nothing changed — stand the watchdog down.
  local res, err = band_cfg_set(payload)
  if not res then
    os.remove(PENDING)
    return { error = "set_band_config failed: " .. tostring(err) }
  end

  -- Persist a "You applied bands" event for the Tracking timeline.
  local bits = {}
  if applied.reset then bits[#bits + 1] = "reset: filtering off, mode AUTO" end
  if applied.sa  then bits[#bits + 1] = "SA "  .. applied.sa:gsub(":", " n"):gsub("^", "n") end
  if applied.nsa then bits[#bits + 1] = "NSA " .. applied.nsa:gsub(":", " n"):gsub("^", "n") end
  if applied.lte then bits[#bits + 1] = "LTE " .. applied.lte:gsub(":", " B"):gsub("^", "B") end
  if applied.mode and not applied.reset then bits[#bits + 1] = "mode " .. applied.mode end
  append_event("user", "Bands applied", table.concat(bits, "; "))

  return { ok = true, window = 60, applied = applied, sub_id = sub_id, slot = slot }
end

-- READ: the recorded history (samples + user/dog events) for the Tracking page.
-- Two ways to ask, and the difference matters:
--   { window_ms = <ms> }  — a RELATIVE window, resolved against the BOX clock.
--                           What the page sends for its initial load and for a
--                           range backfill.
--   { since = <epoch ms> }— records strictly newer than this instant. What the
--                           10s poll sends, carrying the newest sample's OWN
--                           timestamp — a value the box itself stamped.
-- Neither form lets the browser's clock decide how much history comes back.
-- ⚠️ An absolute `since` computed browser-side (now - 15min) was the earlier
-- design and it silently mis-sized the window by however far the two clocks had
-- drifted: a laptop 10 minutes slow asked for 25 minutes of data, one 10 minutes
-- fast got a nearly empty graph. Timezone was never involved — Date.now() and
-- os.time() are both UTC epoch — but absolute skew on a travel router is real.
-- Neither given => everything retained (24h). Files absent (collector not
-- started) => empty arrays.
--
-- Read the TAIL of an append-ordered jsonl file BACKWARD in chunks, stopping at
-- the window edge. Returns decoded records oldest-first. Shared by get_history
-- and get_battery_history.
--
-- ⚠️ Do not "simplify" this into a read-all-then-filter loop. That was the
-- original, and on the box over 14.6k lines / 3.8 MB it cost ~7.4 s of CPU —
-- FLAT: a 15-minute window (224 samples) cost exactly what the full 24 h
-- (14,647) did, on page load AND on every 10 s poll. The bytes are cheap
-- (read("*a") of 3.8 MB = 0.09 s) and 226 cjson.decodes are 0.005 s; the cost is
-- materialising 14.6k interned strings in one growing table. Cost is now
-- O(window): a 15 m load and each poll are ~10 ms.
local READ_CHUNK = 65536
local function read_window(path, since)
  local fh = io.open(path, "r")
  if not fh then return {} end
  local pos   = fh:seek("end")
  local carry = ""                                   -- head fragment: a line cut by the chunk edge
  local rev   = {}                                   -- collected newest-first
  local done  = false
  while pos > 0 and not done do
    local from = pos - READ_CHUNK
    if from < 0 then from = 0 end
    fh:seek("set", from)
    local buf = (fh:read(pos - from) or "") .. carry
    pos = from
    if pos > 0 then                                  -- buf's first line is (probably) incomplete:
      local nl = buf:find("\n", 1, true)             -- hold it back for the next, earlier read
      if nl then carry, buf = buf:sub(1, nl - 1), buf:sub(nl + 1)
      else carry, buf = buf, "" end                  -- no newline in the chunk: it's all one fragment
    else carry = "" end                              -- reached the file start: nothing left to splice
    local lines = {}
    for line in buf:gmatch("[^\n]+") do lines[#lines + 1] = line end
    for i = #lines, 1, -1 do
      local ok, obj = pcall(cjson.decode, lines[i])  -- cjson.decode can't yield; pcall is safe here
      if ok and type(obj) == "table" and obj.t then
        if since and obj.t <= since then done = true; break end  -- window edge: stop reading
        rev[#rev + 1] = obj
      end                                            -- malformed line: skip, keep scanning
    end
  end
  fh:close()
  local out = {}                                     -- flip back to oldest-first (the contract)
  for i = #rev, 1, -1 do out[#out + 1] = rev[i] end
  return out
end

-- Resolve the {window_ms} / {since} argument pair against the BOX clock.
-- Callers send one or the other; if both arrive, honour the narrower.
local function window_since(args, now)
  local since = args and tonumber(args.since) or nil
  local win   = args and tonumber(args.window_ms) or nil
  if win and win > 0 then
    local rel = now - win
    since = (since == nil) and rel or math.max(since, rel)
  end
  return since
end

function M.get_history(args)
  local now   = os.time() * 1000
  local since = window_since(args, now)
  return { samples = arr(read_window(SAMPLES, since)),
           events  = arr(read_window(EVENTS, since)),
           now     = now }
end

-- Battery history (issue #1). Same {window_ms}/{since} contract as get_history,
-- read from the collector's battery.jsonl. No `events` key: the chart's
-- annotations (plug/unplug, charging band, the limit-engaged marker) are all
-- DERIVED client-side from the sample stream.
function M.get_battery_history(args)
  local now = os.time() * 1000
  return { samples = arr(read_window(BATTERY, window_since(args, now))), now = now }
end

-- Keep a pending change: stand the watchdog down. The change itself was
-- written through GL's store (set_band_config / set_cell_tower) when it was
-- applied, so it is ALREADY durable — cellular_manager re-applies GL's store on
-- restart. Nothing here can fail, which is exactly what makes Keep honest.
function M.confirm(args)
  local kind = pending_get("KIND") or "bands"
  os.remove(PENDING)
  append_event("user", "Kept", kind == "cell" and "Cell lock confirmed" or "Band change confirmed")
  return { ok = true, confirmed = true, durable = true }
end

-- Revert a pending change NOW (don't wait out the window). Writes the previous
-- config back and clears pending, so the still-sleeping watchdog then finds
-- nothing to do. Same restore the watchdog would perform on timeout.
function M.revert_now(args)
  if not file_exists(PENDING) then return { ok = true, note = "nothing pending" } end

  if pending_get("KIND") == "cell" then
    local slot = tonumber(pending_get("SLOT"))

    -- The modem-side undo — GL-INDEPENDENT raw-AT unlock FIRST (it is what
    -- actually frees the link), then the three pref restores — is the
    -- watchdog's restore_from_pending, run synchronously. One implementation
    -- for the manual and the window-end revert, so they cannot drift. It
    -- clears PENDING and stands the sleeping watchdog down on success; on
    -- failure it keeps both, and so do we.
    local r = restore_now()
    if not r or not r.ok then
      return { error = "restore failed: " .. tostring((r and r.error) or "restore-now gave no answer")
                       .. " (pending kept, watchdog still armed)" }
    end

    -- THEN reconcile GL's store, best-effort — the link is already safe by
    -- this point regardless of whether this succeeds. If it fails, get_lock's
    -- derived `stale` (GL locked, modem unlocked) has the page offer "Clear
    -- it" instead of silently disagreeing with the modem.
    local res, gerr
    if slot then res, gerr = gl_unlock(slot) else gerr = "no SLOT in pending" end
    return { ok = true, reverted = true, gl_reconciled = res and true or false,
             gl_error = (not res) and tostring(gerr) or nil }
  end

  -- Bands: write GL's own previous config back (the snapshot set_bands took).
  -- Deliberately in-process (ngx.location.capture) rather than via restore-now:
  -- from inside an nginx worker the shell's route (gl-session -> HTTP POST to
  -- /rpc) would need ANOTHER free worker to serve it, and the manual revert
  -- must not fall to the watchdog's open-state fallback — the user is here to
  -- decide, and a failure keeps the watchdog armed to retry at window end.
  local prev_json = pending_get("PREV_BAND_CONFIG")
  local ok, prev = pcall(cjson.decode, prev_json or "")   -- pure C decode; cannot yield
  if not ok or type(prev) ~= "table" then
    return { error = "pending file has no usable band snapshot; use the ssh panic restore" }
  end
  local res, err = band_cfg_set(prev)
  if not res then
    -- Leave PENDING + the watchdog in place: it will retry the same restore
    -- at the window's end, and the page keeps offering Revert.
    return { error = "restore failed: " .. tostring(err) .. " (watchdog still armed)" }
  end
  os.remove(PENDING)
  os.remove(ARMED)
  append_event("user", "Reverted", "Restored previous bands")
  return { ok = true, reverted = true, restored = prev }
end

-- ============================ Phase 3: AT console ============================
-- Raw AT over OUR OWN channel (/dev/at_mdm0), NOT GL's modem.CPU.AT. The heavy
-- lifting — flock serialization, drain/terminator read loop, timeout — lives
-- in the Python tool; this method only clamps args, spawns it, and parses the
-- per-step envelope (MM-AT:<status>:<elapsed_ms>:<i>/<n>). The port has NO
-- sub_id: it answers for the ACTIVE subscription only. Nothing of GL's is
-- stopped (4.10's poller is cellular_manager via modem_AT on another port).
--
-- io.popen blocks this nginx worker until the tool exits. The tool self-limits
-- to timeout + lock-wait, so the block is bounded (consistent with the
-- existing os.execute use in set_bands). No ubus in here, so no cosocket, so
-- this is safe even though it blocks.
local AT_TOOL = os.getenv("MUDIMODEM_AT_TOOL") or "/usr/lib/mudimodem/mudimodem-at.py"

function M.at_console(args)
  local raw = args and args.cmd
  if type(raw) ~= "string" then return { error = "cmd required" } end
  -- Split into steps on newlines; trim each, drop blanks. (Was: collapse to a
  -- space. Now each line is its own AT command in one held channel window.)
  local steps = {}
  -- Don't reassign the for-loop control var (Lua 5.4+ treats it as <const>).
  for rawline in (raw .. "\n"):gmatch("(.-)\n") do
    local line = rawline:gsub("[\r]+", ""):match("^%s*(.-)%s*$")
    if line ~= "" then steps[#steps + 1] = line end
  end
  if #steps == 0 then return { error = "cmd required" } end
  if #steps > 8 then return { error = "too many steps (max 8)" } end
  for _, s in ipairs(steps) do
    if #s > 256 then return { error = "command too long (max 256 chars)" } end
  end

  local timeout = tonumber(args and args.timeout) or 8
  if timeout < 1 then timeout = 1 end
  if timeout > 60 then timeout = 60 end
  timeout = math.floor(timeout)

  -- POSIX single-quote escaping: ' -> '\''. Build one invocation, all steps.
  local function q(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
  local parts = { "python3", q(AT_TOOL), "--envelope", "--timeout", tostring(timeout), q("--") }
  for _, s in ipairs(steps) do parts[#parts + 1] = q(s) end
  local f = io.popen(table.concat(parts, " ") .. " 2>/dev/null")
  if not f then return { error = "failed to spawn the AT tool" } end
  local out = f:read("*a") or ""
  f:close()

  -- Channel-level failure: a 2-field frame (no /count) as the first line.
  local cstatus = out:match("^MM%-AT:(%w+):%d+%s*\n") or out:match("^MM%-AT:(%w+):%d+%s*$")
  if cstatus == "busy" then return { error = "channel busy - another command in flight" } end
  if cstatus == "openfail" then return { error = "cannot open the AT port (/dev/at_mdm0)" } end

  -- Parse per-step frames: header line then response lines up to the next header.
  local out_steps, cur = {}, nil
  for line in (out .. "\n"):gmatch("(.-)\n") do
    local st, msv, idx, cnt = line:match("^MM%-AT:(%w+):(%d+):(%d+)/(%d+)$")
    if st then
      cur = { status = st, elapsed_ms = tonumber(msv), idx = tonumber(idx),
              count = tonumber(cnt), response = "" }
      out_steps[#out_steps + 1] = cur
    elseif cur then
      cur.response = cur.response .. line .. "\n"
    end
  end

  if #out_steps == 0 then
    return { error = "AT tool returned no envelope (is " .. AT_TOOL .. " deployed?)" }
  end

  local result = { ok = true, requested = #steps, ran = #out_steps,
                   aborted = (#out_steps < #steps), steps = {} }
  for i, s in ipairs(out_steps) do
    if s.status ~= "ok" and s.status ~= "error" and s.status ~= "timeout" then
      return { error = "AT tool returned unexpected status: " .. s.status }
    end
    result.steps[i] = { cmd = steps[i] or "", status = s.status,
                        response = s.response, elapsed_ms = s.elapsed_ms }
  end
  return result
end

-- ======================= Phase: AT library sync (check/refresh) ==============
-- library_status / refresh_library spawn mudimodem-lib (a separate tool; see
-- reference) with a fixed literal mode arg ("check"/"refresh") — no user input
-- reaches the shell, so no injection concern. Neither touches ubus, so no
-- cosocket concern with the pcall(cjson.decode, ...) below (§8: never pcall a
-- ubus call; cjson.decode is a plain C function, can't yield, pcall is safe).
local LIB_TOOL = os.getenv("MUDIMODEM_LIB_TOOL") or "/usr/lib/mudimodem/mudimodem-lib"

local function run_lib(mode)
  local q = "'" .. LIB_TOOL:gsub("'", "'\\''") .. "'"
  local f = io.popen("python3 " .. q .. " " .. mode .. " 2>/dev/null")
  if not f then return { error = "failed to spawn the library tool" } end
  local out = f:read("*a") or ""
  f:close()
  local ok, obj = pcall(cjson.decode, out)   -- cjson.decode can't yield; pcall is safe (§8)
  if not ok or type(obj) ~= "table" then
    return { error = "library tool returned no JSON" }
  end
  return obj
end

function M.library_status(args)
  return run_lib("check")
end

function M.refresh_library(args)
  return run_lib("refresh")
end

-- ============================ Speedtest ============================
-- On-demand (+ optional scheduled) download/upload/latency test. The test
-- itself is pure IP traffic run by tools/mudimodem-speedtest.py, spawned
-- DETACHED (like mudimodem-revert) because a fixed-size test takes ~10-20s --
-- too long for a single $rpcRequest. Results persist in /etc/mudimodem (NOT
-- /tmp, unlike the RF-history telemetry) so they survive a normal reboot.
local SPEEDTEST_BIN      = os.getenv("MUDIMODEM_SPEEDTEST_BIN")      or "/usr/lib/mudimodem/mudimodem-speedtest.py"
local SPEEDTEST_HIST     = os.getenv("MUDIMODEM_SPEEDTEST_HIST")     or "/etc/mudimodem/speedtests.jsonl"
local SPEEDTEST_STATUS   = os.getenv("MUDIMODEM_SPEEDTEST_STATUS")   or "/tmp/mudimodem/speedtest-status.json"
local SPEEDTEST_SCHEDULE = os.getenv("MUDIMODEM_ST_SCHEDULE")        or "/etc/mudimodem/speedtest-schedule.json"

-- Allowed schedule cadences (seconds) -- the UI's fixed dropdown (30m/1h/2h/
-- 6h/12h/24h); set_speedtest_schedule refuses anything else.
local SCHEDULE_SECONDS = { [1800] = true, [3600] = true, [7200] = true,
                           [21600] = true, [43200] = true, [86400] = true }

-- Resolve an outbound interface ("cellular"|"wired") to its LIVE Linux device
-- via ubus network.interface dump -- NEVER hardcoded. This box's own eth0 is
-- bridged into LAN rather than acting as WAN, and the cellular device index
-- has been observed to change (rmnet_data0 <-> rmnet_data1) after a modem
-- reconnect, so resolving fresh every call is the only correct approach.
-- Returns { device = <string|nil>, up = <bool> }.
local function resolve_iface(which)
  local dump = ucall("network.interface", "dump", {})
  local ifaces = (dump and dump.interface) or {}
  local function pick(dev)
    if nullish(dev) then return nil end
    return dev
  end
  if which == "cellular" then
    for _, i in ipairs(ifaces) do
      local name = tostring(i.interface or "")
      if i.proto == "rmnet" and not name:match("_6$") then
        local dev = pick(i.l3_device) or pick(i.device)
        return { device = dev, up = (i.up == true) and dev ~= nil }
      end
    end
  elseif which == "wired" then
    for _, i in ipairs(ifaces) do
      if i.interface == "wan" then
        local dev = pick(i.l3_device) or pick(i.device)
        return { device = dev, up = (i.up == true) and dev ~= nil }
      end
    end
  end
  return { device = nil, up = false }
end

function M.get_speedtest_interfaces(args)
  return { cellular = resolve_iface("cellular"), wired = resolve_iface("wired") }
end

local function read_json_file(path, default)
  local f = io.open(path, "r")
  if not f then return default end
  local raw = f:read("*a")
  f:close()
  local ok, obj = pcall(cjson.decode, raw)   -- cjson.decode can't yield; pcall is safe here
  if not ok or type(obj) ~= "table" then return default end
  return obj
end

local function write_json_file(path, obj)
  local dir = path:match("(.*/)")
  if dir then os.execute("mkdir -p " .. dir .. " 2>/dev/null") end
  local f = io.open(path, "w")
  if not f then return false end
  f:write(cjson.encode(obj))
  f:close()
  return true
end

function M.run_speedtest(args)
  local iface = (args and args.iface) or "cellular"
  if iface ~= "cellular" and iface ~= "wired" then
    return { error = "iface must be 'cellular' or 'wired'" }
  end
  local info = resolve_iface(iface)
  if not info.up or not info.device then
    return { error = "iface_down", iface = iface }
  end

  local st = read_json_file(SPEEDTEST_STATUS, nil)
  if st and st.running then return { running = true } end

  os.execute("mkdir -p /etc/mudimodem /tmp/mudimodem 2>/dev/null")
  write_json_file(SPEEDTEST_STATUS, { running = true, phase = "starting", iface = iface })
  local quoted_bin = "'" .. SPEEDTEST_BIN:gsub("'", "'\\''") .. "'"
  spawn_detached("python3 " .. quoted_bin .. " --trigger manual --iface " .. iface)
  return { started = true }
end

function M.get_speedtest_status(args)
  return read_json_file(SPEEDTEST_STATUS, { running = false })
end

function M.get_speedtest_history(args)
  local since = args and tonumber(args.since) or nil
  local iface = args and args.iface or nil
  local limit = args and tonumber(args.limit) or nil
  local out = {}
  local fh = io.open(SPEEDTEST_HIST, "r")
  if fh then
    for line in fh:lines() do
      if #line > 1 then
        local ok, obj = pcall(cjson.decode, line)
        if ok and type(obj) == "table" and obj.t then
          if (not since or obj.t > since) and (not iface or obj.iface == iface) then
            out[#out + 1] = obj
          end
        end
      end
    end
    fh:close()
  end
  if limit and #out > limit then
    local trimmed = {}
    for i = #out - limit + 1, #out do trimmed[#trimmed + 1] = out[i] end
    out = trimmed
  end
  return { results = arr(out) }
end

function M.clear_speedtest_history(args)
  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local f = io.open(SPEEDTEST_HIST, "w")
  if f then f:close() end
  return { ok = true }
end

function M.get_speedtest_schedule(args)
  return read_json_file(SPEEDTEST_SCHEDULE, { enabled = false, interval_seconds = 21600, last_run = 0 })
end

function M.set_speedtest_schedule(args)
  local enabled = (args and args.enabled) and true or false
  local interval = tonumber(args and args.interval_seconds)
  if not interval or not SCHEDULE_SECONDS[interval] then
    return { error = "interval_seconds must be one of 1800/3600/7200/21600/43200/86400" }
  end
  local cur = M.get_speedtest_schedule({})
  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local f = io.open(SPEEDTEST_SCHEDULE, "w")
  if not f then return { error = "cannot write schedule config" } end
  f:write(cjson.encode({ enabled = enabled, interval_seconds = interval, last_run = cur.last_run or 0 }))
  f:close()
  return { ok = true, enabled = enabled, interval_seconds = interval }
end

-- ======================= Phase 5: MudiModem version check ====================
-- app_version reads the installed version from a local file and the latest from
-- version.json on GitHub main. No ubus here (a plain file read + a curl
-- subprocess), so pcall(cjson.decode, ...) is safe (§8: pcall is only unsafe
-- around a ubus cosocket call). The URL is a fixed constant — no RPC arg reaches
-- the shell. Fail-silent: any network/parse failure sets error + checked=false.
local VERSION_FILE = os.getenv("MUDIMODEM_VERSION_FILE") or "/etc/mudimodem/version.json"
local DEFAULT_BASE = "https://raw.githubusercontent.com/Antiman-cmyk/MudiModem/main"
local CURL         = os.getenv("MUDIMODEM_CURL") or "curl"

-- { version, base } from the file install.sh wrote. `base` is the raw-URL root
-- the install came from (fork/branch aware); the update check follows it so a
-- fork install is never offered upstream's version as an "update".
local function read_version_file()
  local f = io.open(VERSION_FILE, "r")
  if not f then return "unknown", DEFAULT_BASE end
  local s = f:read("*a") or ""
  f:close()
  local ok, obj = pcall(cjson.decode, s)   -- cjson.decode can't yield; pcall safe (§8)
  if ok and type(obj) == "table" then
    -- Same allowlist mudimodem-selfupdate applies (keep the two in sync): a
    -- plain URL charset incl. ':' for a port — a dev box serving its own tree
    -- over http://host:8000 is a legitimate base both readers must agree on.
    local base = (type(obj.base) == "string" and obj.base:match("^https?://[%w%.%-_:/]+$")) and obj.base or DEFAULT_BASE
    return (obj.version and tostring(obj.version)) or "unknown", base
  end
  return "unknown", DEFAULT_BASE
end

function M.app_version(args)
  local installed, base = read_version_file()
  local out = { installed = installed, latest = nil, source = base,
                update_available = false, checked = false }
  local url = os.getenv("MUDIMODEM_VERSION_URL") or (base .. "/version.json")
  -- Shell-escaped defensively; the base is validated to a plain URL charset above.
  local q = "'" .. url:gsub("'", "'\\''") .. "'"
  local f = io.popen(CURL .. " -fsS --max-time 8 " .. q .. " 2>/dev/null")
  if not f then out.error = "curl spawn failed"; return out end
  local body = f:read("*a") or ""
  f:close()
  local ok, obj = pcall(cjson.decode, body)
  if not ok or type(obj) ~= "table" or not obj.version then
    out.error = "remote version.json unreachable or malformed"
    return out
  end
  out.latest = tostring(obj.version)
  out.checked = true
  out.update_available = (out.latest ~= out.installed)
  return out
end

-- device_info: model + CPU for the Config tab. The browser-facing `system` rpc
-- object has no `board` method, so we read it server-side via ubus (through
-- ucall — never pcall, per §8).
function M.device_info(args)
  local r = ucall("system", "board", {})
  if type(r) ~= "table" then return { model = "", cpu = "" } end
  return { model = r.model or "", cpu = r.system or "" }
end

-- self_update launches the detached self-update script and returns at once
-- (install.sh restarts nginx; running it in-handler would drop this connection).
-- update_status polls the lockdir + result file the script writes. No ubus here,
-- so no cosocket concern. The script path is a fixed constant.
local SELFUPDATE_BIN = os.getenv("MUDIMODEM_SELFUPDATE_BIN") or "/usr/sbin/mudimodem-selfupdate"
local UPDATE_LOCK    = os.getenv("MUDIMODEM_UPDATE_LOCK")   or "/etc/mudimodem/update.lock.d"
local UPDATE_RESULT  = os.getenv("MUDIMODEM_UPDATE_RESULT") or "/etc/mudimodem/update-result.json"

function M.self_update(args)
  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  -- Fresh run: clear any stale result so update_status reflects THIS attempt.
  os.remove(UPDATE_RESULT)
  spawn_detached(SELFUPDATE_BIN)
  return { ok = true, started = true }
end

function M.update_status(args)
  -- lockdir present => an update is running.
  local lock = io.open(UPDATE_LOCK .. "/.", "r")
  local in_progress = false
  if lock then lock:close(); in_progress = true
  else
    -- io.open on a directory path is unreliable; probe with a shell test instead.
    in_progress = (os.execute("[ -d '" .. UPDATE_LOCK .. "' ]") == 0
                or os.execute("[ -d '" .. UPDATE_LOCK .. "' ]") == true)
  end
  local result = nil
  local f = io.open(UPDATE_RESULT, "r")
  if f then
    local s = f:read("*a") or ""; f:close()
    local ok, obj = pcall(cjson.decode, s)
    if ok and type(obj) == "table" then result = obj end
  end
  return { in_progress = in_progress, result = result }
end

-- ---- Battery charge limit (Config tab) ------------------------------------
-- Policy file + glbattlimit CLI. No ubus. Spec:
-- docs/superpowers/specs/2026-07-22-battery-charge-limit-design.md
-- Env (MUDIMODEM_BATTLIMIT_FILE / MUDIMODEM_BATTLIMIT_BIN) re-read each call
-- so isolation tests can override after dofile.

local function battlimit_file()
  return os.getenv("MUDIMODEM_BATTLIMIT_FILE") or "/etc/mudimodem/battlimit.json"
end
local function battlimit_bin()
  return os.getenv("MUDIMODEM_BATTLIMIT_BIN") or "/usr/bin/glbattlimit"
end

local function batt_defaults()
  return { enabled = false, limit_gui = 80 }
end

local function read_batt_policy()
  local p = batt_defaults()
  local f = io.open(battlimit_file(), "r")
  if not f then return p end
  local body = f:read("*a") or ""; f:close()
  local ok, obj = pcall(cjson.decode, body)
  if not ok or type(obj) ~= "table" then return p end
  if type(obj.enabled) == "boolean" then p.enabled = obj.enabled end
  local g = tonumber(obj.limit_gui)
  if g and g == math.floor(g) and g >= 20 and g <= 100 then p.limit_gui = g end
  return p
end

local function write_batt_policy(enabled, limit_gui)
  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local path = battlimit_file()
  local tmp = path .. ".tmp." .. tostring(os.time())
  local f, err = io.open(tmp, "w")
  if not f then return false, err or "open failed" end
  -- cjson encodes booleans correctly; keep pretty-min for ash sed extract.
  f:write(string.format('{"enabled":%s,"limit_gui":%d}\n',
    enabled and "true" or "false", limit_gui))
  f:close()
  local ok = os.rename(tmp, path)
  if not ok then os.remove(tmp); return false, "rename failed" end
  return true
end

local function run_glbattlimit(args)
  -- args is a shell-safe string already built from validated integers / fixed words.
  -- Returns: output_text, success (exit 0).
  local bin = battlimit_bin()
  local f = io.popen(bin .. " " .. args .. " 2>/dev/null")
  if not f then return nil, false end
  local out = f:read("*a") or ""
  -- Lua 5.1: close → true/nil; Lua 5.2+: true|"exit"|code or nil|"exit"|code
  local c1, c2, c3 = f:close()
  local success
  if c3 ~= nil then
    success = (c3 == 0)
  else
    success = (c1 == true) or (c1 == 0)
  end
  return out, success
end

local function bin_available()
  local bin = battlimit_bin()
  -- executable check (Lua 5.1 returns int exit status; 5.2+ returns true/nil)
  return (os.execute("[ -x '" .. bin:gsub("'", "'\\''") .. "' ]") == 0)
      or (os.execute("[ -x '" .. bin:gsub("'", "'\\''") .. "' ]") == true)
end

-- Parse `glbattlimit status` human text. Tolerant of small format drift.
local function parse_status(text)
  local s = {
    active = false, active_gauge = nil,
    capacity_gauge = nil, capacity_gui = nil,
    charger_online = false,
  }
  if not text or text == "" then return s end
  if text:find("Limit%s*:%s*active", 1) then
    s.active = true
    local ag = text:match("active %((%d+)%s*%%%s*gauge")
    if ag then s.active_gauge = tonumber(ag) end
  end
  local cg, cgui = text:match("Capacity%s*:%s*(%d+)%s*%%%s*gauge%s*/%s*~(%d+)%s*%%%s*GUI")
  if cg then s.capacity_gauge = tonumber(cg) end
  if cgui then s.capacity_gui = tonumber(cgui) end
  local on = text:match("Charger%s*:%s*online=(%d)")
  if on == "1" then s.charger_online = true end
  return s
end

-- GUI→gauge using the same integer formula as the tool (gui2gauge).
local function gui_to_gauge(gui)
  local GUI_M, GUI_B = 13867, 189300
  return math.floor((gui * 10000 + GUI_B + GUI_M / 2) / GUI_M)
end

local function snapshot_battlimit()
  local pol = read_batt_policy()
  local out = {
    enabled = pol.enabled,
    limit_gui = pol.limit_gui,
    limit_gauge = gui_to_gauge(pol.limit_gui),
    gui_m = 13867,          -- the chunk converts gauge -> GUI for display; serving
    gui_b = 189300,         -- the constants here keeps that formula in ONE place
    active = false,
    active_gauge = nil,
    capacity_gauge = nil,
    capacity_gui = nil,
    charger_online = false,
    available = false,
    error = nil,
  }
  if not bin_available() then
    out.error = "glbattlimit not installed"
    return out
  end
  out.available = true
  local text = run_glbattlimit("status")
  if not text or text == "" or text:find("ERROR:", 1, true) then
    out.available = false
    out.error = "glbattlimit status failed"
    return out
  end
  local st = parse_status(text)
  out.active = st.active
  out.active_gauge = st.active_gauge
  out.capacity_gauge = st.capacity_gauge
  out.capacity_gui = st.capacity_gui
  out.charger_online = st.charger_online
  return out
end

function M.get_battlimit(args)
  return snapshot_battlimit()
end

function M.set_battlimit(args)
  args = args or {}
  local enabled = args.enabled
  local limit_gui = tonumber(args.limit_gui)
  if type(enabled) ~= "boolean"
     or not limit_gui or limit_gui ~= math.floor(limit_gui)
     or limit_gui < 20 or limit_gui > 100 then
    local out = snapshot_battlimit()
    out.error = "invalid params"
    return out
  end
  -- glbattlimit enforces gauge 50–100 after gui2gauge; reject before write.
  local gauge = gui_to_gauge(limit_gui)
  if gauge < 50 or gauge > 100 then
    local out = snapshot_battlimit()
    out.error = "limit too low (min ~50% gauge / use higher GUI %)"
    return out
  end
  local ok, err = write_batt_policy(enabled, limit_gui)
  if not ok then
    local out = snapshot_battlimit()
    out.error = err or "write failed"
    return out
  end
  if not bin_available() then
    local out = snapshot_battlimit()
    out.error = "glbattlimit not installed"
    return out
  end
  if not enabled then
    run_glbattlimit("off")
    local out = snapshot_battlimit()
    if out.active then
      out.error = "could not deactivate limit"
    end
    return out
  end
  -- Only apply live when charger is online; otherwise policy is armed for hotplug.
  local st = parse_status((run_glbattlimit("status")))
  if st.charger_online then
    run_glbattlimit("on " .. tostring(limit_gui) .. " gui")
    local out = snapshot_battlimit()
    -- enabled + plugged but watcher not running → tool rejected or failed silently
    if out.enabled and out.charger_online and not out.active then
      out.error = "could not activate limit"
    end
    return out
  end
  return snapshot_battlimit()
end

-- ---- History eMMC backup (Config tab) ------------------------------------
-- Live history stays on tmpfs. When enabled, mudimodem-collectd periodically
-- appends new samples to /etc/mudimodem/history/ (approach #2). Off by default.
-- Spec session 2026-07-29. Collectd re-reads the policy file each flush — no
-- SIGHUP / restart needed when the checkbox flips.

local function history_cfg_file()
  return os.getenv("MUDIMODEM_HISTORY_CFG") or "/etc/mudimodem/history.json"
end
local function history_persist_dir()
  return os.getenv("MUDIMODEM_HISTORY_PERSIST") or "/etc/mudimodem/history"
end

local function read_history_policy()
  local p = { enabled = false }
  local f = io.open(history_cfg_file(), "r")
  if not f then return p end
  local body = f:read("*a") or ""; f:close()
  local ok, obj = pcall(cjson.decode, body)
  if ok and type(obj) == "table" and obj.enabled == true then
    p.enabled = true
  end
  return p
end

local function write_history_policy(enabled)
  os.execute("mkdir -p /etc/mudimodem 2>/dev/null")
  local path = history_cfg_file()
  local tmp = path .. ".tmp." .. tostring(os.time())
  local f, err = io.open(tmp, "w")
  if not f then return false, err or "open failed" end
  f:write(string.format('{"enabled":%s}\n', enabled and "true" or "false"))
  f:close()
  local ok = os.rename(tmp, path)
  if not ok then os.remove(tmp); return false, "rename failed" end
  return true
end

local function history_dir_bytes(dir)
  -- BusyBox du often lacks -b; sum known files with wc -c instead.
  local total = 0
  for _, name in ipairs({ "samples.jsonl", "battery.jsonl" }) do
    local f = io.open(dir .. "/" .. name, "r")
    if f then
      local sz = f:seek("end")
      f:close()
      if type(sz) == "number" then total = total + sz end
    end
  end
  return total
end

local function snapshot_history_persist()
  local pol = read_history_policy()
  local dir = history_persist_dir()
  local out = {
    enabled = pol.enabled,
    path = dir,
    size_bytes = 0,
    flush_interval_s = 600,
  }
  -- Size of the on-disk backup only (what reboot survives), not the live tmpfs.
  local st = io.open(dir, "r")
  if st then
    st:close()
    out.size_bytes = history_dir_bytes(dir)
  end
  return out
end

function M.get_history_persist(args)
  return snapshot_history_persist()
end

function M.set_history_persist(args)
  args = args or {}
  if type(args.enabled) ~= "boolean" then
    local out = snapshot_history_persist()
    out.error = "enabled must be a boolean"
    return out
  end
  local ok, err = write_history_policy(args.enabled)
  if not ok then
    local out = snapshot_history_persist()
    out.error = err or "could not write policy"
    return out
  end
  if args.enabled then
    os.execute("mkdir -p '" .. history_persist_dir():gsub("'", "'\\''") .. "' 2>/dev/null")
  end
  return snapshot_history_persist()
end

return M
